---
import LandingLayout from '../../layouts/LandingLayout.astro';
import GuideDownloadForm from '../../components/forms/GuideDownloadForm.astro';
---

<LandingLayout title="First-Time Buyer's Guide: Save Thousands on Your First Home | Stairway Mortgage" description="Download the free First-Time Buyer's Guide — 5 breakthroughs that could save you thousands. Stop renting, start building equity.">

  <!-- HERO -->
  <section class="lp-hero" style="--accent:#1845D6">
    <div class="lp-hero__inner">
      <div class="lp-hero__text">
        <span class="lp-hero__step mono">Step 02 of 08 · The First Door</span>
        <h1 class="lp-hero__title">First-Time Home Buyer</h1>
        <p class="lp-hero__lead">This is the first door — the step where you stop paying someone else's mortgage and start building your own equity. For most people, the first home is the single most important financial move they'll make.</p>
        <button class="lp-hero__cta" type="button" data-open-guide data-guide="First-Time Buyer's Guide">
          Download Free Guide →
        </button>
      </div>
      <div class="lp-hero__visuals">
        <img class="lp-hero__photo" src="https://images.pexels.com/photos/8293700/pexels-photo-8293700.jpeg?auto=compress&cs=tinysrgb&w=1280" alt="Smiling first-time buyers holding the keys to their new home" loading="eager" onerror="this.onerror=null;this.src='https://placehold.co/1000x667/16335B/FAFAF9?text=Stairway';" />
        <img class="lp-hero__book" src="https://pub-9f05e4d14a8440e08d1b243082a7dc01.r2.dev/guides/First%20Time%20Buyers.png" alt="First-Time Buyer's Guide book cover" loading="eager" />
      </div>
    </div>
  </section>

  <!-- WHAT'S INSIDE -->
  <section class="lp-inside">
    <div class="lp-inside__inner">
      <span class="lp-eyebrow mono">What's inside the guide</span>
      <h2 class="lp-inside__title">5 Breakthroughs That Could Save You Thousands (and Your Sanity)</h2>
      <ul class="lp-inside__bullets">
        <li>Think your 750 credit score is helping you? It might be the reason you're losing deals to buyers with a 680. (Chapter 3 — What lenders and realtors won't say out loud.)</li>
        <li>The millionaire move no one's teaching: how to borrow from your 401(k) to fund your down payment — without wrecking your retirement. (Chapter 10 — Real leverage, real strategy.)</li>
        <li>One negotiation phrase can save you $5,000–$15,000 on closing day — even against higher offers. (Chapter 13 — Use it once, remember it forever.)</li>
        <li>The myth of needing 20% down is dead. Why 3–5% down could launch your wealth-building journey faster than waiting. (Chapter 12 — Stop stalling. Start growing.)</li>
        <li>The 90-day transformation plan that boosts credit, lowers DTI, builds savings — and flips the "I'm not ready" script for good. (Chapter 6 — This isn't motivation. It's momentum.)</li>
      </ul>
      <button class="lp-inside__cta" type="button" data-open-guide data-guide="First-Time Buyer's Guide">
        Get Your Free Copy →
      </button>
    </div>
  </section>

  <!-- WHO IS THIS FOR -->
  <section class="lp-who">
    <div class="lp-who__inner">
      <span class="lp-eyebrow mono">Who this is for</span>
      <h2 class="lp-who__title">This step is for you if…</h2>
      <div class="lp-who__cards">
        <div class="lp-who__card"><p>First-time buyers unsure where to start</p></div>
        <div class="lp-who__card"><p>Renters ready to stop building someone else's equity</p></div>
        <div class="lp-who__card"><p>Buyers with complex income (self-employed, commission, new to the country)</p></div>
        <div class="lp-who__card"><p>Anyone who's been told 'no' elsewhere and needs options</p></div>
      </div>
    </div>
  </section>

  <!-- THE SHIFT -->
  <section class="lp-shift" style="--accent:#1845D6">
    <div class="lp-shift__inner">
      <span class="lp-eyebrow mono">The mindset shift</span>
      <blockquote class="lp-shift__quote">From consumer to owner — from rent receipts to an asset that grows with you.</blockquote>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="lp-final">
    <div class="lp-final__inner">
      <h2 class="lp-final__title">Ready to take the next step?</h2>
      <p class="lp-final__lead">Download your free guide and start your journey today.</p>
      <button class="lp-final__cta" type="button" data-open-guide data-guide="First-Time Buyer's Guide">
        Download Free Guide →
      </button>
      <p class="lp-final__sub mono">Instant download · No credit card · No obligation</p>
    </div>
  </section>

  <GuideDownloadForm />
</LandingLayout>

<style>
  .lp-hero { background: var(--color-forest, #1f3d34); color: #f4f5ef; padding: clamp(3rem,7vw,5rem) 1.25rem; }
  .lp-hero__inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2rem,4vw,3.5rem); align-items: center; }
  .lp-hero__step { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: .75rem; display: block; }
  .lp-hero__title { font-family: var(--stw-display, 'Fraunces'), Georgia, serif; font-weight: 600; font-size: clamp(2rem,5vw,3.2rem); line-height: 1.08; margin: 0 0 1.25rem; color: #f4f5ef; }
  .lp-hero__lead { font-size: clamp(.95rem,1.5vw,1.12rem); line-height: 1.65; color: #c9d6cf; max-width: 52ch; margin: 0 0 1.75rem; }
  .lp-hero__cta { display: inline-flex; align-items: center; gap: .4rem; background: var(--accent); color: #fff; font-family: var(--stw-body, 'Inter'), sans-serif; font-weight: 600; font-size: .95rem; padding: .85rem 1.8rem; border-radius: 999px; border: 0; cursor: pointer; transition: transform .15s, box-shadow .15s; }
  .lp-hero__cta:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,.3); }
  .lp-hero__visuals { position: relative; display: flex; justify-content: center; align-items: center; }
  .lp-hero__photo { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 14px; border: 1px solid rgba(255,255,255,.1); }
  .lp-hero__book { position: absolute; bottom: -24px; right: -16px; width: 160px; filter: drop-shadow(0 16px 32px rgba(0,0,0,.4)); border-radius: 4px; }
  @media(max-width:768px) {
    .lp-hero__inner { grid-template-columns: 1fr; }
    .lp-hero__book { width: 120px; bottom: -16px; right: 8px; }
  }

  .lp-inside { padding: clamp(3rem,6vw,5rem) 1.25rem; background: var(--color-paper, #f7f5ef); }
  .lp-inside__inner { max-width: 720px; margin: 0 auto; }
  .lp-eyebrow { font-size: .66rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--color-mute, #6b7770); display: block; margin-bottom: .75rem; }
  .lp-inside__title { font-family: var(--stw-display, 'Fraunces'), Georgia, serif; font-weight: 600; font-size: clamp(1.5rem,3vw,2.2rem); line-height: 1.15; margin: 0 0 1.5rem; color: var(--color-ink, #1a2420); }
  .lp-inside__bullets { list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: .9rem; }
  .lp-inside__bullets li { position: relative; padding-left: 1.5rem; font-size: .94rem; line-height: 1.55; color: #374151; }
  .lp-inside__bullets li::before { content: '\2192'; position: absolute; left: 0; color: var(--color-royal, #2f47c9); font-weight: 600; }
  .lp-inside__cta { display: inline-flex; align-items: center; gap: .4rem; background: var(--color-royal, #2f47c9); color: #fff; font-family: var(--stw-body, 'Inter'), sans-serif; font-weight: 600; font-size: .92rem; padding: .8rem 1.6rem; border-radius: 999px; border: 0; cursor: pointer; transition: transform .15s, box-shadow .15s; }
  .lp-inside__cta:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(47,71,201,.28); }

  .lp-who { padding: clamp(3rem,6vw,5rem) 1.25rem; background: var(--color-paper-tint, #f0ede5); }
  .lp-who__inner { max-width: 900px; margin: 0 auto; }
  .lp-who__title { font-family: var(--stw-display, 'Fraunces'), Georgia, serif; font-weight: 600; font-size: clamp(1.4rem,3vw,2rem); margin: 0 0 1.5rem; color: var(--color-ink); }
  .lp-who__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .lp-who__card { background: #fff; border: 1px solid var(--color-bone, #e3e0d6); border-radius: 12px; padding: 1.25rem 1.4rem; }
  .lp-who__card p { font-size: .92rem; line-height: 1.5; color: var(--color-ink-light, #2a3430); margin: 0; }
  @media(max-width:560px) { .lp-who__cards { grid-template-columns: 1fr; } }

  .lp-shift { padding: clamp(2.5rem,5vw,4rem) 1.25rem; background: var(--color-ink, #1a2420); color: #f4f5ef; text-align: center; }
  .lp-shift__inner { max-width: 640px; margin: 0 auto; }
  .lp-shift .lp-eyebrow { color: var(--accent); }
  .lp-shift__quote { font-family: var(--stw-display, 'Fraunces'), Georgia, serif; font-size: clamp(1.3rem,3vw,1.9rem); line-height: 1.35; font-weight: 400; font-style: italic; margin: 0; border: 0; padding: 0; color: rgba(244,245,239,.9); }

  .lp-final { padding: clamp(3rem,6vw,5rem) 1.25rem; background: var(--color-forest, #1f3d34); color: #f4f5ef; text-align: center; }
  .lp-final__inner { max-width: 560px; margin: 0 auto; }
  .lp-final__title { font-family: var(--stw-display, 'Fraunces'), Georgia, serif; font-weight: 600; font-size: clamp(1.6rem,4vw,2.4rem); margin: 0 0 .75rem; color: #f4f5ef; }
  .lp-final__lead { font-size: 1rem; color: #c9d6cf; margin: 0 0 1.5rem; line-height: 1.6; }
  .lp-final__cta { display: inline-flex; align-items: center; gap: .4rem; background: var(--color-royal, #2f47c9); color: #fff; font-family: var(--stw-body, 'Inter'), sans-serif; font-weight: 600; font-size: 1rem; padding: .9rem 2rem; border-radius: 999px; border: 0; cursor: pointer; transition: transform .15s, box-shadow .15s; }
  .lp-final__cta:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(47,71,201,.28); }
  .lp-final__sub { font-size: .68rem; color: rgba(255,255,255,.45); margin-top: 1rem; letter-spacing: .06em; }
</style>
