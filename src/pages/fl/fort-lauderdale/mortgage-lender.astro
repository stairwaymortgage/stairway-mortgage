---
/**
 * /fl/fort-lauderdale/mortgage-lender/
 * Rebuilt from old WP Elementor page — keyword-targeted local landing page.
 *
 * COMPLIANCE:
 *   - Stat corrected: $350M → $500M+ (locked).
 *   - NEXA NMLS #1660690 → footer only (Layout/Footer.astro).
 *   - Jim individual NMLS #1072866 in body (founder context).
 *   - CTAs: "See My Options" / "Talk to Our Team".
 */
import Layout from '../../../layouts/Layout.astro';

const phone = '(954) 993-1625';
const phoneHref = 'tel:+19549931625';

const neighborhoods = [
  { name: 'Las Olas Isles & Blvd', type: 'Jumbo / Super-Jumbo', range: '$2M–$8M+' },
  { name: 'Harbor Beach', type: 'Super-Jumbo / Alt-Doc', range: '$3M–$15M+' },
  { name: 'Rio Vista', type: 'Conventional / FHA 203k', range: '$800K–$3M' },
  { name: 'Victoria Park', type: 'FHA / Conv / Physician', range: '$400K–$1.2M' },
  { name: 'Flagler Village', type: 'Non-Warrantable Condo', range: '$300K–$800K' },
  { name: 'Coral Ridge', type: 'Conventional / Jumbo', range: '$600K–$2.5M' },
  { name: 'Progresso Village & Sailboat Bend', type: 'DSCR / Fix-and-Flip', range: '$250K–$600K' },
  { name: 'Ft Lauderdale Beach / Galt Ocean Mile', type: 'Non-Warrantable / Foreign National', range: '$400K–$5M+' },
  { name: 'Wilton Manors & Oakland Park', type: 'VA / DSCR / First-Time', range: '$350K–$900K' },
  { name: 'Plantation, Weston & Davie', type: 'Conv / Bank Statement', range: '$400K–$1.5M' },
];
---

<Layout
  title="Mortgage Lender in Fort Lauderdale | Stairway Mortgage | Direct Lending + 300 Wholesale Partners"
  description="Stairway Mortgage is a Fort Lauderdale direct mortgage lender and broker with access to 300+ wholesale lenders. In-house underwriting plus wholesale rate shopping."
  canonical="/fl/fort-lauderdale/mortgage-lender/"
>
  <main class="ml-scope">

    <!-- HERO -->
    <section class="section ml-hero">
      <div class="container-page">
        <p class="eyebrow eyebrow-blue">Fort Lauderdale Mortgage Lender</p>
        <h1 class="display-xl">Fort Lauderdale FL Mortgage Lender — Direct Funding, Local Expertise</h1>
        <p class="lede">Stairway Mortgage is a Fort Lauderdale direct mortgage lender and broker with access to 300+ wholesale lenders. In-house underwriting when speed matters, wholesale rate shopping when savings matter — the best of both worlds.</p>
        <div class="ml-actions">
          <a href="/see-my-options/" class="btn btn-blue">See My Options — Same-Day Pre-Approval</a>
          <a href={phoneHref} class="btn btn-ghost">{phone}</a>
        </div>
      </div>
    </section>

    <!-- WHY CHOOSE -->
    <section class="section section-tinted">
      <div class="container-page">
        <div class="section-header">
          <p class="eyebrow eyebrow-rust">Why Stairway Mortgage</p>
          <h2 class="display-md">Why choose Stairway Mortgage as your Fort Lauderdale mortgage lender</h2>
        </div>
        <p class="lede">Led by Jim Blackburn (NMLS #1072866), a Scotsman Guide Top Producer with $500M+ in personally closed loans and seven consecutive years among the nation's top originators.</p>

        <div class="ml-grid-3">
          <article class="ml-card">
            <h3 class="ml-card-title">Direct lender capabilities</h3>
            <p>In-house underwriting and funding means faster approvals, fewer conditions, and more control over your timeline. When speed matters, we fund directly.</p>
          </article>
          <article class="ml-card">
            <h3 class="ml-card-title">300+ wholesale lender network</h3>
            <p>Access to specialized programs and competitive pricing from over 300 wholesale partners. When savings matter, we shop the entire market for you.</p>
          </article>
          <article class="ml-card">
            <h3 class="ml-card-title">Complex loan expertise</h3>
            <p>Bank statement loans, DSCR investor loans, asset-based lending, non-QM programs, jumbo, and FHA/VA/USDA conventional loans — all under one roof.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- DUAL MODEL -->
    <section class="section">
      <div class="container-prose">
        <div class="section-header">
          <p class="eyebrow eyebrow-blue">The Dual Model</p>
          <h2 class="display-md">How our dual lending model works for you</h2>
        </div>
        <div class="ml-process">
          <article class="ml-step">
            <div class="ml-step-num mono">01</div>
            <div>
              <h3 class="ml-step-title">Check our direct channel first</h3>
              <p>We check our direct lending channel first for speed, pricing, and fit — can we fund this in-house faster and cheaper?</p>
            </div>
          </article>
          <article class="ml-step">
            <div class="ml-step-num mono">02</div>
            <div>
              <h3 class="ml-step-title">Shop 300+ wholesale partners</h3>
              <p>We simultaneously shop our 300+ wholesale partners to compare rates, terms, and program features against our direct channel.</p>
            </div>
          </article>
          <article class="ml-step">
            <div class="ml-step-num mono">03</div>
            <div>
              <h3 class="ml-step-title">Present the best option</h3>
              <p>We present you with the best option — period — regardless of which channel it comes from. Your interests come first.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- MARKET CONTEXT -->
    <section class="section section-tinted">
      <div class="container-page">
        <div class="section-header">
          <p class="eyebrow eyebrow-rust">Market Knowledge</p>
          <h2 class="display-md">Why Fort Lauderdale borrowers need a specialized mortgage lender</h2>
        </div>
        <div class="ml-grid-2">
          <article class="ml-card">
            <h3 class="ml-card-title">40%+ price growth since 2020</h3>
            <p>Fort Lauderdale's rapid appreciation drives jumbo lending necessity — many properties now exceed conforming limits.</p>
          </article>
          <article class="ml-card">
            <h3 class="ml-card-title">Post-Surfside condo requirements</h3>
            <p>New structural requirements create non-warrantable financing challenges that require specialized lender relationships.</p>
          </article>
          <article class="ml-card">
            <h3 class="ml-card-title">$3K–$12K annual flood insurance</h3>
            <p>High flood insurance costs impact debt-to-income ratios — an experienced lender knows which programs account for this.</p>
          </article>
          <article class="ml-card">
            <h3 class="ml-card-title">International buyer demand</h3>
            <p>Fort Lauderdale's international buyer population requires foreign national and ITIN programs most lenders don't offer.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- NEIGHBORHOODS -->
    <section class="section">
      <div class="container-page">
        <div class="section-header">
          <p class="eyebrow eyebrow-blue">Local Coverage</p>
          <h2 class="display-md">Fort Lauderdale neighborhoods our mortgage lending team serves</h2>
        </div>
        <div class="ml-table-wrap">
          <table class="ml-nbr-table">
            <thead>
              <tr><th>Neighborhood</th><th>Common Loan Type</th><th>Price Range</th></tr>
            </thead>
            <tbody>
              {neighborhoods.map((n) => (
                <tr><td>{n.name}</td><td>{n.type}</td><td class="mono">{n.range}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- LOCAL EXPERTISE -->
    <section class="section section-tinted">
      <div class="container-page">
        <div class="section-header">
          <p class="eyebrow eyebrow-rust">Expertise</p>
          <h2 class="display-md">Fort Lauderdale mortgage lending — local expertise matters</h2>
        </div>
        <div class="ml-grid-2">
          <article class="ml-card">
            <h3 class="ml-card-title">Condo financing</h3>
            <p>Warrantable and non-warrantable condo programs. Navigation of post-Surfside structural requirements and condo questionnaire challenges.</p>
          </article>
          <article class="ml-card">
            <h3 class="ml-card-title">Foreign national lending</h3>
            <p>Programs with 25–30% down, no U.S. credit requirement. Closings in personal name or through an LLC.</p>
          </article>
          <article class="ml-card">
            <h3 class="ml-card-title">Flood zone navigation</h3>
            <p>Understanding how flood insurance costs impact qualifying ratios and which lenders handle flood-zone properties best.</p>
          </article>
          <article class="ml-card">
            <h3 class="ml-card-title">Investment property financing</h3>
            <p>DSCR underwriting calibrated to Fort Lauderdale rental yields, short-term rental financing, and multi-family investment strategies.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- WHO WE SERVE -->
    <section class="section">
      <div class="container-prose">
        <div class="section-header">
          <p class="eyebrow eyebrow-blue">Who We Serve</p>
          <h2 class="display-md">Borrowers we work with every day</h2>
        </div>
        <ul class="ml-serve-list">
          <li><strong>Self-employed business owners</strong> needing bank statement or P&L qualifying</li>
          <li><strong>Real estate investors</strong> scaling with DSCR and asset-based loans</li>
          <li><strong>High-income professionals</strong> — physicians, attorneys, executives</li>
          <li><strong>First-time homebuyers</strong> seeking FHA, VA, or down payment assistance</li>
          <li><strong>Foreign nationals and expats</strong> purchasing South Florida real estate</li>
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section-tinted">
      <div class="container-prose">
        <div class="section-header">
          <p class="eyebrow">Common Questions</p>
          <h2 class="display-md">Frequently asked questions</h2>
        </div>
        <div class="ml-faq">
          <details class="faq-item">
            <summary class="faq-q"><span class="faq-num">01</span>What makes Stairway Mortgage different from other Fort Lauderdale mortgage lenders?</summary>
            <div class="faq-a"><p>Unlike a typical Fort Lauderdale mortgage lender that offers only their own products, Stairway Mortgage operates as both a direct lender and licensed broker with 300+ wholesale partners. You get in-house speed when it matters and wholesale rate shopping when savings matter.</p></div>
          </details>
          <details class="faq-item">
            <summary class="faq-q"><span class="faq-num">02</span>What types of mortgage loans are available in Fort Lauderdale?</summary>
            <div class="faq-a"><p>Conventional, FHA, VA, USDA, jumbo, bank statement, DSCR investor, asset-based, foreign national, and non-QM programs — all available through our direct and wholesale channels.</p></div>
          </details>
          <details class="faq-item">
            <summary class="faq-q"><span class="faq-num">03</span>How do I choose the right mortgage lender in Fort Lauderdale?</summary>
            <div class="faq-a"><p>Look for lending model access (direct + broker is ideal), local expertise in South Florida's specific challenges (condos, flood zones, international buyers), verifiable production volume, and a track record with complex scenarios.</p></div>
          </details>
          <details class="faq-item">
            <summary class="faq-q"><span class="faq-num">04</span>How fast can a Fort Lauderdale mortgage lender close my loan?</summary>
            <div class="faq-a"><p>Through our direct lending channel, we can close in as few as 14–21 days for straightforward purchase transactions. Complex scenarios typically close in 30–45 days.</p></div>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section ml-cta">
      <div class="container-page">
        <h2 class="display-lg">Ready to work with a Fort Lauderdale mortgage lender who puts you first?</h2>
        <p class="lede">Direct funding when speed matters. 300+ lenders when savings matter. No pressure, no jargon.</p>
        <div class="ml-actions">
          <a href="/see-my-options/" class="btn btn-blue">See My Options</a>
          <a href={phoneHref} class="btn btn-ghost">{phone}</a>
        </div>
      </div>
    </section>

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FinancialService',
      name: 'Stairway Mortgage — Fort Lauderdale Mortgage Lender',
      telephone: phone,
      areaServed: 'Fort Lauderdale, FL',
      address: { '@type': 'PostalAddress', streetAddress: '912 SW 20th St', addressLocality: 'Fort Lauderdale', addressRegion: 'FL', postalCode: '33315', addressCountry: 'US' },
    })} />
  </main>
</Layout>

<style>
  .ml-scope { --ml-gap: clamp(1rem, 2vw, 1.5rem); }
  .ml-scope .section-tinted { background: var(--color-paper-tint); }
  .ml-scope .section-header { margin-bottom: 2rem; max-width: 56ch; }
  .ml-scope .section-header h2 { margin-top: 0.5rem; }

  .ml-hero .display-xl { font-size: clamp(2.5rem, 5.5vw, 4.5rem); line-height: 1.06; max-width: 22ch; }
  .ml-scope .lede { max-width: 62ch; }
  .ml-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .ml-grid-3 {
    display: grid; gap: var(--ml-gap);
    grid-template-columns: repeat(3, 1fr); margin-top: 2rem;
  }
  @media (max-width: 768px) { .ml-scope .ml-grid-3 { grid-template-columns: 1fr; } }

  .ml-grid-2 {
    display: grid; gap: var(--ml-gap);
    grid-template-columns: repeat(2, 1fr); margin-top: 2rem;
  }
  @media (max-width: 640px) { .ml-scope .ml-grid-2 { grid-template-columns: 1fr; } }

  .ml-card {
    background: var(--color-paper); border: 1px solid var(--color-bone);
    border-radius: 4px; padding: 1.5rem;
  }
  .ml-card-title { font-family: var(--stw-display); font-size: 1.1rem; margin-bottom: 0.5rem; }

  .ml-process { display: grid; gap: 1.5rem; margin-top: 2rem; }
  .ml-step { display: flex; gap: 1rem; align-items: baseline; }
  .ml-step-num { color: var(--color-blue); font-size: 1.1rem; flex-shrink: 0; min-width: 2.5rem; }
  .ml-step-title { font-family: var(--stw-display); font-size: 1.1rem; margin-bottom: 0.4rem; }

  .ml-table-wrap { overflow-x: auto; margin-top: 2rem; }
  .ml-nbr-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .ml-nbr-table th {
    text-align: left; padding: 0.75rem 1rem; border-bottom: 2px solid var(--color-bone);
    font-family: var(--stw-mono); font-size: 0.8rem; letter-spacing: 0.03em; color: var(--color-mute);
  }
  .ml-nbr-table td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-bone); }

  .ml-serve-list { margin: 1.5rem 0 0 1.1rem; }
  .ml-serve-list li { margin-bottom: 0.75rem; }

  .ml-faq { margin-top: 1.5rem; }
  .ml-faq .faq-item { border-bottom: 1px solid var(--color-bone); padding: 1rem 0; }
  .ml-faq .faq-q { cursor: pointer; display: flex; gap: 0.75rem; align-items: baseline; font-family: var(--stw-display); font-size: 1.05rem; list-style: none; }
  .ml-faq .faq-q::-webkit-details-marker { display: none; }
  .ml-faq .faq-num { font-family: var(--stw-mono); color: var(--color-blue); font-size: 0.8rem; }
  .ml-faq .faq-a { padding-top: 0.75rem; color: var(--color-mute); }

  .ml-cta { text-align: center; padding-block: clamp(3rem, 6vw, 5rem); }
  .ml-cta .ml-actions { justify-content: center; }
</style>
