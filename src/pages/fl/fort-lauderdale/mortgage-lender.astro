---
/**
 * /fl/fort-lauderdale/mortgage-lender/
 * Production landing page — keyword-targeted local mortgage lender page.
 *
 * COMPLIANCE:
 *   - Stat: $500M+ (locked).
 *   - NEXA NMLS #1660690 → footer only (Layout/Footer.astro).
 *   - Jim individual NMLS #1072866 in body (founder context).
 *   - CTAs: "See My Options" / "Talk to Our Team".
 */
import Layout from '../../../layouts/Layout.astro';

const phone = '(954) 993-1625';
const phoneHref = 'tel:+19549931625';

const neighborhoods = [
  { name: 'Las Olas Isles & Blvd', type: 'Jumbo / Super-Jumbo', range: '$2M\u2013$8M+' },
  { name: 'Harbor Beach', type: 'Super-Jumbo / Alt-Doc', range: '$3M\u2013$15M+' },
  { name: 'Rio Vista', type: 'Conventional / FHA 203k', range: '$800K\u2013$3M' },
  { name: 'Victoria Park', type: 'FHA / Conv / Physician', range: '$400K\u2013$1.2M' },
  { name: 'Flagler Village', type: 'Non-Warrantable Condo', range: '$300K\u2013$800K' },
  { name: 'Coral Ridge', type: 'Conventional / Jumbo', range: '$600K\u2013$2.5M' },
  { name: 'Progresso Village & Sailboat Bend', type: 'DSCR / Fix-and-Flip', range: '$250K\u2013$600K' },
  { name: 'Ft Lauderdale Beach / Galt Ocean Mile', type: 'Non-Warrantable / Foreign National', range: '$400K\u2013$5M+' },
  { name: 'Wilton Manors & Oakland Park', type: 'VA / DSCR / First-Time', range: '$350K\u2013$900K' },
  { name: 'Plantation, Weston & Davie', type: 'Conv / Bank Statement', range: '$400K\u2013$1.5M' },
];

const lenderLogos = [
  { src: '/lender-logos/UWM.webp', alt: 'UWM' },
  { src: '/lender-logos/newrez.webp', alt: 'Newrez' },
  { src: '/lender-logos/NEWdi.webp', alt: 'New Direction' },
  { src: '/lender-logos/lead.webp', alt: 'Lead' },
  { src: '/lender-logos/community.webp', alt: 'Community' },
  { src: '/lender-logos/EPM.webp', alt: 'EPM' },
  { src: '/lender-logos/omana.webp', alt: 'Omana' },
];

const faqs = [
  {
    q: 'What makes Stairway Mortgage different from other Fort Lauderdale mortgage lenders?',
    a: 'Unlike a typical Fort Lauderdale mortgage lender that offers only their own products, Stairway Mortgage operates as both a direct lender and licensed broker with 300+ wholesale partners. You get in-house speed when it matters and wholesale rate shopping when savings matter.',
  },
  {
    q: 'What types of mortgage loans are available in Fort Lauderdale?',
    a: 'Conventional, FHA, VA, USDA, jumbo, bank statement, DSCR investor, asset-based, foreign national, and non-QM programs \u2014 all available through our direct and wholesale channels.',
  },
  {
    q: 'How do I choose the right mortgage lender in Fort Lauderdale?',
    a: 'Look for lending model access (direct + broker is ideal), local expertise in South Florida\'s specific challenges (condos, flood zones, international buyers), verifiable production volume, and a track record with complex scenarios.',
  },
  {
    q: 'How fast can a Fort Lauderdale mortgage lender close my loan?',
    a: 'Through our direct lending channel, we can close in as few as 14\u201321 days for straightforward purchase transactions. Complex scenarios typically close in 30\u201345 days.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  name: 'Stairway Mortgage \u2014 Fort Lauderdale Mortgage Lender',
  telephone: phone,
  areaServed: 'Fort Lauderdale, FL',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '912 SW 20th St',
    addressLocality: 'Fort Lauderdale',
    addressRegion: 'FL',
    postalCode: '33315',
    addressCountry: 'US',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    bestRating: '5',
    ratingCount: '150',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.stairwaymortgage.com/' },
    { '@type': 'ListItem', position: 2, name: 'Fort Lauderdale', item: 'https://www.stairwaymortgage.com/fl/fort-lauderdale/' },
    { '@type': 'ListItem', position: 3, name: 'Mortgage Lender', item: 'https://www.stairwaymortgage.com/fl/fort-lauderdale/mortgage-lender/' },
  ],
};
---

<Layout
  title="Mortgage Lender in Fort Lauderdale | Stairway Mortgage | Direct Lending + 300 Wholesale Partners"
  description="Stairway Mortgage is a Fort Lauderdale direct mortgage lender and broker with access to 300+ wholesale lenders. In-house underwriting plus wholesale rate shopping."
  canonical="/fl/fort-lauderdale/mortgage-lender/"
  ogImage="/wp-content/uploads/2025/11/A_photograph_captures_a_mortgage_consultation_meet.webp"
>
  <main class="ml-scope">

    <!-- BREADCRUMB -->
    <nav class="ml-breadcrumb" aria-label="Breadcrumb">
      <div class="container-page">
        <ol class="ml-breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li><a href="/fl/fort-lauderdale/">Fort Lauderdale</a></li>
          <li aria-current="page">Mortgage Lender</li>
        </ol>
      </div>
    </nav>

    <!-- ============================================================
         SECTION 1 — HERO
         ============================================================ -->
    <section class="ml-hero">
      <div class="container-page ml-hero-inner">
        <div class="ml-hero-content">
          <p class="eyebrow ml-hero-eyebrow">Fort Lauderdale Mortgage Lender</p>
          <h1 class="display-xl ml-hero-h1">Fort Lauderdale FL Mortgage Lender — Direct Funding, Local Expertise</h1>
          <p class="ml-hero-lede">Stairway Mortgage is a Fort Lauderdale direct mortgage lender and broker with access to 300+ wholesale lenders. In-house underwriting when speed matters, wholesale rate shopping when savings matter — the best of both worlds.</p>
          <div class="ml-actions">
            <a href="/see-my-options/" class="btn btn-blue">See My Options — Same-Day Pre-Approval</a>
            <a href={phoneHref} class="btn ml-btn-hero-ghost">Talk to Our Team: {phone}</a>
          </div>
        </div>
        <div class="ml-hero-image">
          <img
            src="/wp-content/uploads/2025/11/A_photograph_captures_a_mortgage_consultation_meet.webp"
            alt="Mortgage consultation meeting at Stairway Mortgage in Fort Lauderdale"
            width="640" height="480"
            loading="eager"
            onerror="this.style.display='none'"
          />
        </div>
      </div>
      <!-- Stats bar -->
      <div class="ml-stats-bar">
        <div class="container-page ml-stats-inner">
          <div class="ml-stat fade-in">
            <span class="ml-stat-num" data-target="300">0</span><span class="ml-stat-plus">+</span>
            <span class="ml-stat-label">Wholesale Lenders</span>
          </div>
          <div class="ml-stat fade-in">
            <span class="ml-stat-prefix">$</span><span class="ml-stat-num" data-target="500">0</span><span class="ml-stat-plus">M+</span>
            <span class="ml-stat-label">Loans Closed</span>
          </div>
          <div class="ml-stat fade-in">
            <span class="ml-stat-num" data-target="14">0</span><span class="ml-stat-plus">-Day</span>
            <span class="ml-stat-label">Close Possible</span>
          </div>
          <div class="ml-stat fade-in">
            <span class="ml-stat-num" data-target="5" data-decimal="true">0</span><span class="ml-stat-plus">.0</span>
            <span class="ml-stat-label">Google Rating</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 2 — LENDER TRUST BAR
         ============================================================ -->
    <section class="ml-trust-bar fade-in">
      <div class="container-page">
        <p class="ml-trust-label">Trusted by 300+ wholesale lending partners</p>
        <div class="ml-trust-logos">
          {lenderLogos.map(logo => (
            <img
              src={logo.src}
              alt={logo.alt}
              width="120" height="48"
              loading="lazy"
              class="ml-trust-logo"
              onerror="this.style.display='none'"
            />
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 3 — WHY CHOOSE STAIRWAY
         ============================================================ -->
    <section class="section ml-section-tinted">
      <div class="container-page">
        <div class="ml-section-header fade-in">
          <p class="eyebrow eyebrow-rust">Why Stairway Mortgage</p>
          <h2 class="display-md">Why Choose Stairway Mortgage as Your Fort Lauderdale Mortgage Lender</h2>
        </div>

        <!-- Jim profile -->
        <div class="ml-leader fade-in">
          <div class="ml-leader-photo">
            <img
              src="/wp-content/uploads/2026/03/jim-blackburn-fort-lauderdale.jpg.webp"
              alt="Jim Blackburn — Fort Lauderdale mortgage lender, Scotsman Guide Top Producer"
              width="280" height="350"
              loading="lazy"
              onerror="this.style.display='none'"
            />
          </div>
          <div class="ml-leader-text">
            <h3 class="ml-subtitle">Led by a Scotsman Guide Top Producer</h3>
            <p class="ml-leader-nmls mono">NMLS #1072866</p>
            <p>Jim Blackburn has closed over <strong>$500M+</strong> in loans across seven consecutive years as a Scotsman Guide Top Producer. Jim lives in Fort Lauderdale and serves clients nationwide — combining deep local market knowledge with nationwide lender access.</p>
            <a href="/branches/fort-lauderdale/jim-blackburn-team/" class="ml-link">Meet the team &rarr;</a>
          </div>
        </div>

        <!-- 3 cards -->
        <div class="ml-grid-3">
          <article class="ml-card fade-in">
            <div class="ml-card-icon">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="40" height="40" rx="8" fill="var(--color-royal-tint)"/>
                <path d="M12 20L18 14L24 20L30 12" stroke="var(--color-royal)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 28H30" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="ml-card-title">Direct lender capabilities</h3>
            <p>In-house underwriting and funding means faster approvals, fewer conditions, and more control over your timeline. When speed matters, we fund directly.</p>
          </article>
          <article class="ml-card fade-in">
            <div class="ml-card-icon">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="40" height="40" rx="8" fill="var(--color-royal-tint)"/>
                <path d="M20 10V30M14 16L20 10L26 16" stroke="var(--color-royal)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M13 26H27" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="ml-card-title">300+ wholesale lender network</h3>
            <p>Access to specialized programs and competitive pricing from over 300 wholesale partners. When savings matter, we shop the entire market for you.</p>
          </article>
          <article class="ml-card fade-in">
            <div class="ml-card-icon">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="40" height="40" rx="8" fill="var(--color-royal-tint)"/>
                <circle cx="20" cy="20" r="8" stroke="var(--color-royal)" stroke-width="2.5"/>
                <path d="M20 16V20L23 23" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="ml-card-title">Complex loan expertise</h3>
            <p>Bank statement loans, DSCR investor loans, asset-based lending, non-QM programs, jumbo, and FHA/VA/USDA conventional loans — all under one roof.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 4 — DUAL LENDING MODEL (Timeline)
         ============================================================ -->
    <section class="section">
      <div class="container-page">
        <div class="ml-section-header fade-in" style="max-width:56ch;">
          <p class="eyebrow eyebrow-blue">The Dual Model</p>
          <h2 class="display-md">How Our Dual Lending Model Works</h2>
          <p class="lede" style="margin-top:1rem;">Every loan runs through both channels so you always get the best possible outcome — speed or savings.</p>
        </div>

        <div class="ml-timeline">
          <div class="ml-timeline-line" aria-hidden="true"></div>

          <article class="ml-timeline-step fade-in">
            <div class="ml-timeline-marker"><span class="mono">01</span></div>
            <div class="ml-timeline-content">
              <h3 class="ml-step-title">Check our direct channel first</h3>
              <p>We check our direct lending channel first for speed, pricing, and fit — can we fund this in-house faster and cheaper?</p>
            </div>
          </article>

          <article class="ml-timeline-step fade-in">
            <div class="ml-timeline-marker"><span class="mono">02</span></div>
            <div class="ml-timeline-content">
              <h3 class="ml-step-title">Shop 300+ wholesale partners</h3>
              <p>We simultaneously shop our 300+ wholesale partners to compare rates, terms, and program features against our direct channel.</p>
            </div>
          </article>

          <article class="ml-timeline-step fade-in">
            <div class="ml-timeline-marker"><span class="mono">03</span></div>
            <div class="ml-timeline-content">
              <h3 class="ml-step-title">Present the best option</h3>
              <p>We present you with the best option — period — regardless of which channel it comes from. Your interests come first.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 5 — MARKET CONTEXT
         ============================================================ -->
    <section class="section ml-section-tinted">
      <div class="container-page">
        <div class="ml-section-header fade-in">
          <p class="eyebrow eyebrow-rust">Market Knowledge</p>
          <h2 class="display-md">Why Fort Lauderdale Borrowers Need a Specialized Mortgage Lender</h2>
        </div>
        <div class="ml-grid-4">
          <article class="ml-card ml-card-stat fade-in">
            <div class="ml-card-stat-num">40%+</div>
            <h3 class="ml-card-title">Price growth since 2020</h3>
            <p>Fort Lauderdale's rapid appreciation drives jumbo lending necessity — many properties now exceed conforming limits.</p>
          </article>
          <article class="ml-card ml-card-stat fade-in">
            <div class="ml-card-stat-num">Post-Surfside</div>
            <h3 class="ml-card-title">Condo requirements</h3>
            <p>New structural requirements create non-warrantable financing challenges that require specialized lender relationships.</p>
          </article>
          <article class="ml-card ml-card-stat fade-in">
            <div class="ml-card-stat-num">$3K-$12K</div>
            <h3 class="ml-card-title">Annual flood insurance</h3>
            <p>High flood insurance costs impact debt-to-income ratios — an experienced lender knows which programs account for this.</p>
          </article>
          <article class="ml-card ml-card-stat fade-in">
            <div class="ml-card-stat-num">Global</div>
            <h3 class="ml-card-title">International buyer demand</h3>
            <p>Fort Lauderdale's international buyer population requires foreign national and ITIN programs most lenders don't offer.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 6 — NEIGHBORHOODS TABLE
         ============================================================ -->
    <section class="section">
      <div class="container-page">
        <div class="ml-section-header fade-in">
          <p class="eyebrow eyebrow-blue">Local Coverage</p>
          <h2 class="display-md">Fort Lauderdale Neighborhoods Our Mortgage Lending Team Serves</h2>
        </div>
        <div class="ml-table-wrap fade-in">
          <table class="ml-nbr-table">
            <thead>
              <tr><th>Neighborhood</th><th>Common Loan Type</th><th>Price Range</th></tr>
            </thead>
            <tbody>
              {neighborhoods.map((n, i) => (
                <tr class={i % 2 === 1 ? 'ml-row-alt' : ''}>
                  <td>{n.name}</td>
                  <td>{n.type}</td>
                  <td class="mono">{n.range}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="ml-neighborhood-image fade-in">
          <img
            src="/wp-content/uploads/2025/05/laughing-couple-posing-kitchen-scaled.webp"
            alt="Happy homeowners in their new Fort Lauderdale home after closing with Stairway Mortgage"
            width="800" height="500"
            loading="lazy"
            onerror="this.style.display='none'"
          />
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 7 — LOCAL EXPERTISE
         ============================================================ -->
    <section class="section ml-section-tinted">
      <div class="container-page">
        <div class="ml-section-header fade-in">
          <p class="eyebrow eyebrow-rust">Expertise</p>
          <h2 class="display-md">Local Expertise Matters</h2>
        </div>
        <div class="ml-grid-4">
          <article class="ml-card fade-in">
            <div class="ml-card-icon-sm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 10L12 3L21 10V20C21 20.55 20.55 21 20 21H4C3.45 21 3 20.55 3 20V10Z" stroke="var(--color-royal)" stroke-width="2" stroke-linejoin="round"/><path d="M9 21V12H15V21" stroke="var(--color-royal)" stroke-width="2" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="ml-card-title">Condo financing</h3>
            <p>Warrantable and non-warrantable condo programs. Navigation of post-Surfside structural requirements and condo questionnaire challenges.</p>
          </article>
          <article class="ml-card fade-in">
            <div class="ml-card-icon-sm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7V17L12 22L22 17V7L12 2Z" stroke="var(--color-royal)" stroke-width="2" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="ml-card-title">Foreign national lending</h3>
            <p>Programs with 25-30% down, no U.S. credit requirement. Closings in personal name or through an LLC.</p>
          </article>
          <article class="ml-card fade-in">
            <div class="ml-card-icon-sm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="ml-card-title">Flood zone navigation</h3>
            <p>Understanding how flood insurance costs impact qualifying ratios and which lenders handle flood-zone properties best.</p>
          </article>
          <article class="ml-card fade-in">
            <div class="ml-card-icon-sm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 21L12 3L21 21H3Z" stroke="var(--color-royal)" stroke-width="2" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="ml-card-title">Investment property financing</h3>
            <p>DSCR underwriting calibrated to Fort Lauderdale rental yields, short-term rental financing, and multi-family investment strategies.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 8 — WHO WE SERVE
         ============================================================ -->
    <section class="section">
      <div class="container-page">
        <div class="ml-section-header fade-in">
          <p class="eyebrow eyebrow-blue">Who We Serve</p>
          <h2 class="display-md">Borrowers We Work With Every Day</h2>
        </div>
        <div class="ml-grid-serve">
          <article class="ml-serve-card fade-in">
            <div class="ml-serve-icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect x="4" y="6" width="20" height="16" rx="2" stroke="var(--color-royal)" stroke-width="2"/><path d="M8 14h12M8 18h8" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round"/></svg>
            </div>
            <div>
              <h3 class="ml-serve-title">Self-employed business owners</h3>
              <p>Bank statement or P&L qualifying for entrepreneurs who don't fit traditional income documentation.</p>
            </div>
          </article>
          <article class="ml-serve-card fade-in">
            <div class="ml-serve-icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M4 24L14 4L24 24H4Z" stroke="var(--color-royal)" stroke-width="2" stroke-linejoin="round"/></svg>
            </div>
            <div>
              <h3 class="ml-serve-title">Real estate investors</h3>
              <p>Scaling portfolios with DSCR, asset-based, and fix-and-flip programs across South Florida.</p>
            </div>
          </article>
          <article class="ml-serve-card fade-in">
            <div class="ml-serve-icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="10" r="5" stroke="var(--color-royal)" stroke-width="2"/><path d="M6 24c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round"/></svg>
            </div>
            <div>
              <h3 class="ml-serve-title">High-income professionals</h3>
              <p>Physicians, attorneys, and executives with physician loans, jumbo options, and asset-based qualifying.</p>
            </div>
          </article>
          <article class="ml-serve-card fade-in">
            <div class="ml-serve-icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14 4L4 10V18L14 24L24 18V10L14 4Z" stroke="var(--color-royal)" stroke-width="2" stroke-linejoin="round"/></svg>
            </div>
            <div>
              <h3 class="ml-serve-title">First-time homebuyers</h3>
              <p>FHA, VA, and down payment assistance programs with hands-on guidance through every step.</p>
            </div>
          </article>
          <article class="ml-serve-card fade-in">
            <div class="ml-serve-icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="14" r="10" stroke="var(--color-royal)" stroke-width="2"/><path d="M4 14h20M14 4c-3 3-4.5 6.5-4.5 10s1.5 7 4.5 10c3-3 4.5-6.5 4.5-10S17 7 14 4z" stroke="var(--color-royal)" stroke-width="2"/></svg>
            </div>
            <div>
              <h3 class="ml-serve-title">Foreign nationals & expats</h3>
              <p>Purchasing South Florida real estate with specialized programs requiring no U.S. credit history.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 9 — FAQ
         ============================================================ -->
    <section class="section ml-section-tinted">
      <div class="container-prose">
        <div class="ml-section-header fade-in">
          <p class="eyebrow">Common Questions</p>
          <h2 class="display-md">Frequently Asked Questions</h2>
        </div>
        <div class="ml-faq fade-in">
          {faqs.map((faq, i) => (
            <details class="faq-item">
              <summary class="faq-q">
                <span class="faq-num mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="faq-q-text">{faq.q}</span>
                <svg class="faq-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <div class="faq-a"><p>{faq.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 10 — CLOSING CTA
         ============================================================ -->
    <section class="ml-cta">
      <div class="container-page ml-cta-inner">
        <div class="ml-cta-content fade-in">
