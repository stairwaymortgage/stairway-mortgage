---
/**
 * /fl/fort-lauderdale/mortgage-broker/
 * Rebuilt from old WP Elementor page — keyword-targeted local landing page.
 *
 * COMPLIANCE:
 *   - Stat corrected: $350M → $500M+ (locked).
 *   - NEXA NMLS #1660690 → footer only (Layout/Footer.astro).
 *   - Jim individual NMLS #1072866 in body (founder context).
 *   - CTAs: "See My Options" / "Talk to Our Team".
 */
import Layout from '../../../layouts/Layout.astro';

const phone = '(954) 993-1625';
const phoneHref = 'tel:+19549931625';
const neighborhoods = [
  'Las Olas / Isles', 'Victoria Park', 'Rio Vista', 'Flagler Village',
  'Harbor Beach', 'Wilton Manors', 'Oakland Park', 'Pompano Beach',
  'Hollywood', 'Plantation', 'Weston',
];
---

<Layout
  title="Mortgage Broker in Fort Lauderdale FL | 300+ Lenders, One Local Expert | Stairway Mortgage"
  description="Stairway Mortgage is a Fort Lauderdale mortgage broker with 300+ wholesale lender partners. Rate shopping, non-QM expertise, and direct lending under one roof."
  canonical="/fl/fort-lauderdale/mortgage-broker/"
>
  <main class="mb-scope">

    <!-- HERO -->
    <section class="section mb-hero">
      <div class="container-page">
        <p class="eyebrow eyebrow-blue">Fort Lauderdale Mortgage Broker</p>
        <h1 class="display-xl">Fort Lauderdale FL Mortgage Broker — 300+ Lenders, One Trusted Local Expert</h1>
        <p class="lede">Stairway Mortgage is both a direct mortgage lender in Fort Lauderdale and a mortgage broker with access to over 300 wholesale lending partners — giving you the widest possible selection of loan programs, rates, and terms.</p>
        <div class="mb-actions">
          <a href="/see-my-options/" class="btn btn-blue">See My Options — Same-Day Pre-Approval</a>
          <a href={phoneHref} class="btn btn-ghost">{phone}</a>
        </div>
      </div>
    </section>

    <!-- HOW A BROKER SAVES YOU MONEY -->
    <section class="section section-tinted">
      <div class="container-page">
        <div class="section-header">
          <p class="eyebrow eyebrow-rust">The Broker Advantage</p>
          <h2 class="display-md">How a mortgage broker saves you money in Fort Lauderdale</h2>
        </div>
        <div class="mb-grid-4">
          <article class="mb-card">
            <h3 class="mb-card-title">Rate shopping across 300+ lenders</h3>
            <p>We compare wholesale rates in real time for your specific scenario — not a single institution's posted rate.</p>
          </article>
          <article class="mb-card">
            <h3 class="mb-card-title">Wholesale pricing advantage</h3>
            <p>We access wholesale rates frequently lower than retail bank branches, because wholesale lenders price for the broker channel specifically.</p>
          </article>
          <article class="mb-card">
            <h3 class="mb-card-title">Program matching</h3>
            <p>We know which lender has the best FHA pricing, which approves bank statement loans fastest, and which offers the most aggressive DSCR terms.</p>
          </article>
          <article class="mb-card">
            <h3 class="mb-card-title">One application, multiple options</h3>
            <p>You fill out one application. We do the rest — submitting to multiple lenders simultaneously and presenting you with the best options.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- WHY STAIRWAY -->
    <section class="section">
      <div class="container-page">
        <div class="section-header">
          <p class="eyebrow eyebrow-blue">Why Stairway Mortgage</p>
          <h2 class="display-md">Fort Lauderdale's premier mortgage broker</h2>
        </div>

        <div class="mb-leader">
          <div class="mb-leader-text">
            <h3 class="mb-subtitle">Led by a Scotsman Guide Top Producer</h3>
            <p>Jim Blackburn (NMLS #1072866) has closed over $500M+ in loans across seven consecutive years as a Scotsman Guide Top Producer. Jim lives in Fort Lauderdale and serves clients nationwide.</p>
            <a href="/branches/fort-lauderdale/jim-blackburn-team/" class="mb-link">Meet the team &rarr;</a>
          </div>
        </div>

        <h3 class="mb-subtitle" style="margin-top:2.5rem;">Specialists in loans others can't close</h3>
        <div class="mb-grid-4" style="margin-top:1rem;">
          <article class="mb-card">
            <h3 class="mb-card-title">Bank statement programs</h3>
            <p>12- or 24-month bank statements replace tax returns for self-employed borrowers.</p>
            <a href="/loan-programs/bank-statement-loan/" class="mb-link">Learn more &rarr;</a>
          </article>
          <article class="mb-card">
            <h3 class="mb-card-title">DSCR investor loans</h3>
            <p>Qualify based on property cash flow, not personal income. No W-2s, no tax returns.</p>
            <a href="/loan-programs/dscr-loan/" class="mb-link">Learn more &rarr;</a>
          </article>
          <article class="mb-card">
            <h3 class="mb-card-title">Non-QM lending</h3>
            <p>Flexible documentation, recent credit events, interest-only — programs traditional lenders don't offer.</p>
            <a href="/loan-programs/non-qm-loan/" class="mb-link">Learn more &rarr;</a>
          </article>
          <article class="mb-card">
            <h3 class="mb-card-title">Jumbo &amp; super-jumbo</h3>
            <p>Programs for Fort Lauderdale's luxury waterfront market with alternative documentation options.</p>
            <a href="/loan-programs/jumbo-loan/" class="mb-link">Learn more &rarr;</a>
          </article>
        </div>

        <div class="mb-also-direct">
          <h3 class="mb-subtitle">Also a direct lender</h3>
          <p>Unlike most brokers, Stairway Mortgage also operates as a direct mortgage lender. When speed or control matters, we underwrite and fund in-house. Best of both worlds.</p>
        </div>
      </div>
    </section>

    <!-- WHAT DOES A BROKER DO -->
    <section class="section section-tinted">
      <div class="container-prose">
        <div class="section-header">
          <p class="eyebrow">The Process</p>
          <h2 class="display-md">What does a mortgage broker in Fort Lauderdale actually do?</h2>
        </div>
        <p class="lede">When you hire a mortgage broker in Fort Lauderdale, you're hiring a licensed professional who works on your behalf — not the bank's.</p>

        <div class="mb-process">
          <article class="mb-step">
            <div class="mb-step-num mono">01</div>
            <div>
              <h3 class="mb-step-title">Deep financial analysis</h3>
              <p>Your broker reviews your complete financial picture: income, assets, debts, credit profile, employment history, and property goals. This isn't a surface-level pre-qualification — it's a deep analysis of which lending programs you qualify for and which will produce the best terms.</p>
            </div>
          </article>
          <article class="mb-step">
            <div class="mb-step-num mono">02</div>
            <div>
              <h3 class="mb-step-title">Simultaneous lender submission</h3>
              <p>Your broker submits your scenario to multiple wholesale lenders simultaneously. While a bank loan officer can only check their own institution's guidelines, your broker is running your file against the underwriting criteria of 300+ lending partners — using pricing engines that show live wholesale rates.</p>
            </div>
          </article>
          <article class="mb-step">
            <div class="mb-step-num mono">03</div>
            <div>
              <h3 class="mb-step-title">Options presentation</h3>
              <p>Your Fort Lauderdale mortgage broker presents you with options — not a single take-it-or-leave-it offer. You see the tradeoffs: this lender offers a lower rate but higher closing costs; that lender includes a credit that covers your appraisal fees. You make an informed choice.</p>
            </div>
          </article>
          <article class="mb-step">
            <div class="mb-step-num mono">04</div>
            <div>
              <h3 class="mb-step-title">Closing management</h3>
              <p>Your broker manages the loan through closing: ordering the appraisal, coordinating with the title company, managing conditions with the lender's underwriter, and ensuring nothing falls through the cracks. You have a single point of contact — not a call center.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- COST SECTION -->
    <section class="section">
      <div class="container-prose">
        <div class="section-header">
          <p class="eyebrow eyebrow-blue">Transparency</p>
          <h2 class="display-md">How much does a mortgage broker in Fort Lauderdale cost?</h2>
        </div>
        <p>One of the most common questions borrowers ask is whether using a mortgage broker costs more than going directly to a bank. The answer, in most cases, is that it costs the same or less.</p>
        <p>Mortgage brokers are compensated through the wholesale lender's rate sheet. When a wholesale lender offers a rate to a broker, the compensation is built into that rate — just like a bank builds its profit margin into the rate it offers retail customers. The difference is that wholesale rates start lower, so even after broker compensation, the borrower's net cost is often better than a retail bank's offer.</p>
        <p>At Stairway Mortgage, most Fort Lauderdale mortgage broker fees are paid by the lender, not the borrower. Every fee is disclosed in your Loan Estimate within three business days of application — no surprises.</p>

        <div class="mb-grid-4" style="margin-top:2rem;">
          <article class="mb-card">
            <h3 class="mb-card-title">Wholesale rates start lower</h3>
            <p>Broker channels access wholesale pricing designed for the mortgage industry — not the retail rates banks offer walk-in customers.</p>
          </article>
          <article class="mb-card">
            <h3 class="mb-card-title">Lender-paid compensation</h3>
            <p>Most broker fees are paid by the wholesale lender, not you. When borrower-paid produces better economics, we show both options side by side.</p>
          </article>
          <article class="mb-card">
            <h3 class="mb-card-title">Full fee disclosure</h3>
            <p>Every fee disclosed in your Loan Estimate within 3 business days. No hidden costs, no surprises at the closing table.</p>
          </article>
          <article class="mb-card">
            <h3 class="mb-card-title">Dodd-Frank protection</h3>
            <p>Federal law prohibits mortgage brokers from receiving compensation from both the lender and borrower on the same transaction.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- COMPARISON TABLE -->
    <section class="section section-tinted">
      <div class="container-page">
        <div class="section-header">
          <p class="eyebrow eyebrow-rust">Side by Side</p>
          <h2 class="display-md">What makes Stairway Mortgage different</h2>
        </div>
        <div class="mb-table-wrap">
          <table class="mb-compare">
            <thead>
              <tr><th>Feature</th><th>Mortgage Broker (Stairway)</th><th>Traditional Bank</th></tr>
            </thead>
            <tbody>
              <tr><td>Lender options</td><td class="mb-yes">300+ wholesale lenders</td><td class="mb-no">1 (their own)</td></tr>
              <tr><td>Rate shopping</td><td class="mb-yes">Done for you</td><td class="mb-no">You do it yourself</td></tr>
              <tr><td>Non-QM / specialty</td><td class="mb-yes">Wide selection</td><td class="mb-no">Limited or none</td></tr>
              <tr><td>Wholesale pricing</td><td class="mb-yes">Yes</td><td class="mb-no">No (retail rates)</td></tr>
              <tr><td>Local expertise</td><td class="mb-yes">Jim Blackburn — $500M+</td><td class="mb-no">Rotating officers</td></tr>
              <tr><td>Speed to close</td><td class="mb-yes">Direct + broker channel</td><td class="mb-no">Single pipeline</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- NEIGHBORHOODS -->
    <section class="section">
      <div class="container-page">
        <div class="section-header">
          <p class="eyebrow eyebrow-blue">Local Coverage</p>
          <h2 class="display-md">Serving every Fort Lauderdale neighborhood</h2>
        </div>
        <div class="mb-chips">
          {neighborhoods.map((n) => <span class="mb-chip">{n}</span>)}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section-tinted">
      <div class="container-prose">
        <div class="section-header">
          <p class="eyebrow">Common Questions</p>
          <h2 class="display-md">Frequently asked questions about mortgage brokers in Fort Lauderdale</h2>
        </div>
        <div class="mb-faq">
          <details class="faq-item">
            <summary class="faq-q"><span class="faq-num">01</span>Why should I use a mortgage broker in Fort Lauderdale instead of going to my bank?</summary>
            <div class="faq-a"><p>A bank offers only its own products at its own rates. A broker accesses 300+ wholesale lenders, compares rates and programs in real time, and presents you with the best option for your specific scenario. This is especially valuable in Fort Lauderdale where non-QM lending, condo financing, and investor loans require specialized lender relationships that no single bank maintains.</p></div>
          </details>
          <details class="faq-item">
            <summary class="faq-q"><span class="faq-num">02</span>How do I find the best mortgage broker in Fort Lauderdale?</summary>
            <div class="faq-a"><p>The best Fort Lauderdale mortgage broker will have verifiable production volume (check Scotsman Guide rankings), multiple years of experience in South Florida's specific market challenges (condos, flood zones, international buyers), access to a large wholesale lender network (not just 10–20 lenders), and transparent communication about compensation and fees.</p></div>
          </details>
          <details class="faq-item">
            <summary class="faq-q"><span class="faq-num">03</span>Can a mortgage broker help if I've been turned down by a bank?</summary>
            <div class="faq-a"><p>This is one of the biggest advantages of working with a broker. If one lender declines your application, your broker can immediately submit to alternative lenders with different guidelines. <a href="/loan-programs/bank-statement-loan/">Bank statement programs</a>, <a href="/loan-programs/asset-based-loan/">asset-based loans</a>, recent credit event programs, and <a href="/loan-programs/non-qm-loan/">non-QM options</a> are all available through wholesale channels that retail banks don't offer.</p></div>
          </details>
          <details class="faq-item">
            <summary class="faq-q"><span class="faq-num">04</span>How long does it take to close with a mortgage broker?</summary>
            <div class="faq-a"><p>Typical closings range from 21–30 days for conventional purchases to 30–45 days for complex scenarios. Stairway Mortgage also operates as a direct lender, so when speed is critical, we can fund in-house in as few as 14–21 days.</p></div>
          </details>
          <details class="faq-item">
            <summary class="faq-q"><span class="faq-num">05</span>Is my information safe with a mortgage broker?</summary>
            <div class="faq-a"><p>Licensed mortgage brokers are regulated by the NMLS and state banking regulators. Stairway Mortgage operates with full federal and state compliance, encrypted document handling, and strict data protection protocols.</p></div>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section mb-cta">
      <div class="container-page">
        <h2 class="display-lg">Stop rate shopping alone</h2>
        <p class="lede">Work with Fort Lauderdale's top mortgage broker — one application, 300+ lenders, best options presented.</p>
        <div class="mb-actions">
          <a href="/see-my-options/" class="btn btn-blue">See My Options</a>
          <a href={phoneHref} class="btn btn-ghost">{phone}</a>
        </div>
      </div>
    </section>

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'MortgageBroker',
      name: 'Stairway Mortgage — Fort Lauderdale Mortgage Broker',
      telephone: phone,
      areaServed: 'Fort Lauderdale, FL',
      address: { '@type': 'PostalAddress', streetAddress: '912 SW 20th St', addressLocality: 'Fort Lauderdale', addressRegion: 'FL', postalCode: '33315', addressCountry: 'US' },
    })} />
  </main>
</Layout>

<style>
  .mb-scope { --mb-gap: clamp(1rem, 2vw, 1.5rem); }
  .mb-scope .section-tinted { background: var(--color-paper-tint); }
  .mb-scope .section-header { margin-bottom: 2rem; max-width: 56ch; }
  .mb-scope .section-header h2 { margin-top: 0.5rem; }

  .mb-hero .display-xl { font-size: clamp(2.5rem, 5.5vw, 4.5rem); line-height: 1.06; max-width: 22ch; }
  .mb-scope .lede { max-width: 62ch; }
  .mb-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .mb-grid-4 {
    display: grid; gap: var(--mb-gap);
    grid-template-columns: repeat(2, 1fr); margin-top: 2rem;
  }
  @media (max-width: 640px) { .mb-scope .mb-grid-4 { grid-template-columns: 1fr; } }
  .mb-card {
    background: var(--color-paper); border: 1px solid var(--color-bone);
    border-radius: 4px; padding: 1.5rem;
  }
  .mb-card-title { font-family: var(--stw-display); font-size: 1.1rem; margin-bottom: 0.5rem; }
  .mb-link { font-family: var(--stw-mono); font-size: 0.8rem; color: var(--color-blue); text-decoration: none; letter-spacing: 0.02em; }
  .mb-link:hover { text-decoration: underline; }

  .mb-subtitle { font-family: var(--stw-display); font-size: 1.25rem; margin-bottom: 0.75rem; }
  .mb-leader { margin-top: 2rem; }
  .mb-also-direct { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--color-bone); }

  .mb-process { display: grid; gap: 1.5rem; margin-top: 2rem; }
  .mb-step { display: flex; gap: 1rem; align-items: baseline; }
  .mb-step-num { color: var(--color-blue); font-size: 1.1rem; flex-shrink: 0; min-width: 2.5rem; }
  .mb-step-title { font-family: var(--stw-display); font-size: 1.1rem; margin-bottom: 0.4rem; }

  .mb-table-wrap { overflow-x: auto; margin-top: 2rem; }
  .mb-compare { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .mb-compare th { text-align: left; padding: 0.75rem 1rem; border-bottom: 2px solid var(--color-bone); font-family: var(--stw-mono); font-size: 0.8rem; letter-spacing: 0.03em; color: var(--color-mute); }
  .mb-compare td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-bone); }
  .mb-yes { color: var(--color-ink); font-weight: 500; }
  .mb-no { color: var(--color-mute); }

  .mb-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .mb-chip {
    background: var(--color-paper-tint); border: 1px solid var(--color-bone);
    border-radius: 100px; padding: 0.4rem 1rem; font-size: 0.88rem;
    font-family: var(--stw-mono); letter-spacing: 0.01em;
  }

  .mb-faq { margin-top: 1.5rem; }
  .mb-faq .faq-item { border-bottom: 1px solid var(--color-bone); padding: 1rem 0; }
  .mb-faq .faq-q { cursor: pointer; display: flex; gap: 0.75rem; align-items: baseline; font-family: var(--stw-display); font-size: 1.05rem; list-style: none; }
  .mb-faq .faq-q::-webkit-details-marker { display: none; }
  .mb-faq .faq-num { font-family: var(--stw-mono); color: var(--color-blue); font-size: 0.8rem; }
  .mb-faq .faq-a { padding-top: 0.75rem; color: var(--color-mute); }
  .mb-faq .faq-a a { color: var(--color-blue); }

  .mb-cta { text-align: center; padding-block: clamp(3rem, 6vw, 5rem); }
  .mb-cta .mb-actions { justify-content: center; }
</style>
