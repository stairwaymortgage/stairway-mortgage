                <td class="mb-yes"><span class="mb-check" aria-hidden="true">&#10003;</span> Jim Blackburn — $500M+</td>
                <td class="mb-no"><span class="mb-cross" aria-hidden="true">&#10005;</span> Rotating officers</td>
              </tr>
              <tr>
                <td>Speed to close</td>
                <td class="mb-yes"><span class="mb-check" aria-hidden="true">&#10003;</span> Direct + broker channel</td>
                <td class="mb-no"><span class="mb-cross" aria-hidden="true">&#10005;</span> Single pipeline</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 8 — NEIGHBORHOODS
         ============================================================ -->
