              </summary>
              <div class="faq-a"><p set:html={faq.a} /></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 10 — CLOSING CTA
         ============================================================ -->
    <section class="mb-cta">
      <div class="container-page mb-cta-inner">
        <div class="mb-cta-content fade-in">
          <p class="eyebrow mb-cta-eyebrow">Get Started Today</p>
          <h2 class="display-lg mb-cta-h2">Stop Rate Shopping Alone</h2>
          <p class="mb-cta-lede">Work with Fort Lauderdale's top mortgage broker — one application, 300+ lenders, best options presented to you side by side.</p>
          <div class="mb-actions mb-cta-actions">
            <a href="/see-my-options/" class="btn btn-blue">See My Options</a>
            <a href={phoneHref} class="btn mb-btn-cta-ghost">Talk to Our Team: {phone}</a>
          </div>
        </div>
        <div class="mb-cta-image">
          <img
            src="/wp-content/uploads/2025/05/House-keys.webp"
            alt="House keys representing a successful mortgage closing"
            width="400" height="300"
            loading="lazy"
            onerror="this.style.display='none'"
          />
        </div>
      </div>
    </section>

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

  </main>
</Layout>

<style>
  /* ============================================================
     SCOPED STYLES — .mb-scope prefix for all selectors
     ============================================================ */

  .mb-scope {
    --mb-gap: clamp(1rem, 2vw, 1.5rem);
