---
/**
 * /fl/fort-lauderdale/mortgage-broker/
 * Production landing page — keyword-targeted local mortgage broker page.
 *
 * COMPLIANCE:
 *   - Stat: $500M+ (locked).
 *   - NEXA NMLS #1660690 → footer only (Layout/Footer.astro).
 *   - Jim individual NMLS #1072866 in body (founder context).
 *   - CTAs: "See My Options" / "Talk to Our Team".
 */
import Layout from '../../../layouts/Layout.astro';

const phone = '(954) 993-1625';
const phoneHref = 'tel:+19549931625';
const neighborhoods = [
  'Las Olas / Isles', 'Victoria Park', 'Rio Vista', 'Flagler Village',
  'Harbor Beach', 'Wilton Manors', 'Oakland Park', 'Pompano Beach',
  'Hollywood', 'Plantation', 'Weston',
];

const faqs = [
  {
    q: 'Why should I use a mortgage broker in Fort Lauderdale instead of going to my bank?',
    a: 'A bank offers only its own products at its own rates. A broker accesses 300+ wholesale lenders, compares rates and programs in real time, and presents you with the best option for your specific scenario. This is especially valuable in Fort Lauderdale where non-QM lending, condo financing, and investor loans require specialized lender relationships that no single bank maintains.',
  },
  {
    q: 'How do I find the best mortgage broker in Fort Lauderdale?',
    a: 'The best Fort Lauderdale mortgage broker will have verifiable production volume (check Scotsman Guide rankings), multiple years of experience in South Florida\'s specific market challenges (condos, flood zones, international buyers), access to a large wholesale lender network (not just 10\u201320 lenders), and transparent communication about compensation and fees.',
  },
  {
    q: 'Can a mortgage broker help if I\'ve been turned down by a bank?',
    a: 'This is one of the biggest advantages of working with a broker. If one lender declines your application, your broker can immediately submit to alternative lenders with different guidelines. <a href="/loan-programs/bank-statement-loan/">Bank statement programs</a>, <a href="/loan-programs/asset-based-loan/">asset-based loans</a>, recent credit event programs, and <a href="/loan-programs/non-qm-loan/">non-QM options</a> are all available through wholesale channels that retail banks don\'t offer.',
  },
  {
    q: 'How long does it take to close with a mortgage broker?',
    a: 'Typical closings range from 21\u201330 days for conventional purchases to 30\u201345 days for complex scenarios. Stairway Mortgage also operates as a direct lender, so when speed is critical, we can fund in-house in as few as 14\u201321 days.',
  },
  {
    q: 'Is my information safe with a mortgage broker?',
    a: 'Licensed mortgage brokers are regulated by the NMLS and state banking regulators. Stairway Mortgage operates with full federal and state compliance, encrypted document handling, and strict data protection protocols.',
  },
];

const lenderLogos = [
  { src: '/lender-logos/UWM.webp', alt: 'UWM' },
  { src: '/lender-logos/newrez.webp', alt: 'Newrez' },
  { src: '/lender-logos/NEWdi.webp', alt: 'New Direction' },
  { src: '/lender-logos/lead.webp', alt: 'Lead' },
  { src: '/lender-logos/community.webp', alt: 'Community' },
  { src: '/lender-logos/EPM.webp', alt: 'EPM' },
  { src: '/lender-logos/omana.webp', alt: 'Omana' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'MortgageBroker',
  name: 'Stairway Mortgage — Fort Lauderdale Mortgage Broker',
  telephone: phone,
  areaServed: 'Fort Lauderdale, FL',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '912 SW 20th St',
    addressLocality: 'Fort Lauderdale',
    addressRegion: 'FL',
    postalCode: '33315',
    addressCountry: 'US',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    bestRating: '5',
    ratingCount: '150',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://stairwaymortgage.com/' },
    { '@type': 'ListItem', position: 2, name: 'Fort Lauderdale', item: 'https://stairwaymortgage.com/fl/fort-lauderdale/' },
    { '@type': 'ListItem', position: 3, name: 'Mortgage Broker', item: 'https://stairwaymortgage.com/fl/fort-lauderdale/mortgage-broker/' },
  ],
};
---

<Layout
  title="Mortgage Broker in Fort Lauderdale FL | 300+ Lenders, One Local Expert | Stairway Mortgage"
  description="Stairway Mortgage is a Fort Lauderdale mortgage broker with 300+ wholesale lender partners. Rate shopping, non-QM expertise, and direct lending under one roof."
  canonical="/fl/fort-lauderdale/mortgage-broker/"
  ogImage="/wp-content/uploads/2025/08/couple-meeting-estate-broker-scaled.webp"
>
  <main class="mb-scope">

    <!-- BREADCRUMB -->
    <nav class="mb-breadcrumb" aria-label="Breadcrumb">
      <div class="container-page">
        <ol class="mb-breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li><a href="/fl/fort-lauderdale/">Fort Lauderdale</a></li>
          <li aria-current="page">Mortgage Broker</li>
        </ol>
      </div>
    </nav>

    <!-- ============================================================
         SECTION 1 — HERO
         ============================================================ -->
    <section class="mb-hero">
      <div class="container-page mb-hero-inner">
        <div class="mb-hero-content">
          <p class="eyebrow mb-hero-eyebrow">Fort Lauderdale Mortgage Broker</p>
          <h1 class="display-xl mb-hero-h1">Fort Lauderdale FL Mortgage Broker — 300+ Lenders, One Trusted Local Expert</h1>
          <p class="mb-hero-lede">Stairway Mortgage is both a direct mortgage lender in Fort Lauderdale and a mortgage broker with access to over 300 wholesale lending partners — giving you the widest possible selection of loan programs, rates, and terms.</p>
          <div class="mb-actions">
            <a href="/see-my-options/" class="btn btn-blue">See My Options — Same-Day Pre-Approval</a>
            <a href={phoneHref} class="btn mb-btn-hero-ghost">Talk to Our Team: {phone}</a>
          </div>
        </div>
        <div class="mb-hero-image">
          <img
            src="/wp-content/uploads/2025/08/couple-meeting-estate-broker-scaled.webp"
            alt="Couple meeting with Fort Lauderdale mortgage broker Jim Blackburn at Stairway Mortgage"
            width="640" height="480"
            loading="eager"
            onerror="this.style.display='none'"
          />
        </div>
      </div>
      <!-- Stats bar -->
      <div class="mb-stats-bar">
        <div class="container-page mb-stats-inner">
          <div class="mb-stat fade-in">
            <span class="mb-stat-num" data-target="300">0</span><span class="mb-stat-plus">+</span>
            <span class="mb-stat-label">Wholesale Lenders</span>
          </div>
          <div class="mb-stat fade-in">
            <span class="mb-stat-prefix">$</span><span class="mb-stat-num" data-target="500">0</span><span class="mb-stat-plus">M+</span>
            <span class="mb-stat-label">Loans Closed</span>
          </div>
          <div class="mb-stat fade-in">
            <span class="mb-stat-num" data-target="7">0</span>
            <span class="mb-stat-label">Yrs Top Producer</span>
          </div>
          <div class="mb-stat fade-in">
            <span class="mb-stat-num" data-target="5" data-decimal="true">0</span><span class="mb-stat-plus">.0</span>
            <span class="mb-stat-label">Google Rating</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 2 — LENDER TRUST BAR
         ============================================================ -->
    <section class="mb-trust-bar fade-in">
      <div class="container-page">
        <p class="mb-trust-label">Trusted by 300+ wholesale lending partners</p>
        <div class="mb-trust-logos">
          {lenderLogos.map(logo => (
            <img
              src={logo.src}
              alt={logo.alt}
              width="120" height="48"
              loading="lazy"
              class="mb-trust-logo"
              onerror="this.style.display='none'"
            />
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 3 — HOW A BROKER SAVES YOU MONEY
         ============================================================ -->
    <section class="section mb-section-tinted">
      <div class="container-page">
        <div class="mb-section-header fade-in">
          <p class="eyebrow eyebrow-rust">The Broker Advantage</p>
          <h2 class="display-md">How a Mortgage Broker Saves You Money in Fort Lauderdale</h2>
        </div>
        <div class="mb-grid-4">
          <article class="mb-card fade-in">
            <div class="mb-card-icon">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="40" height="40" rx="8" fill="var(--color-royal-tint)"/>
                <path d="M12 20L18 14L24 20L30 12" stroke="var(--color-royal)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 28H30" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="mb-card-title">Rate shopping across 300+ lenders</h3>
            <p>We compare wholesale rates in real time for your specific scenario — not a single institution's posted rate.</p>
          </article>
          <article class="mb-card fade-in">
            <div class="mb-card-icon">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="40" height="40" rx="8" fill="var(--color-royal-tint)"/>
                <path d="M20 10V30M14 16L20 10L26 16" stroke="var(--color-royal)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M13 26H27" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="mb-card-title">Wholesale pricing advantage</h3>
            <p>We access wholesale rates frequently lower than retail bank branches, because wholesale lenders price for the broker channel specifically.</p>
          </article>
          <article class="mb-card fade-in">
            <div class="mb-card-icon">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="40" height="40" rx="8" fill="var(--color-royal-tint)"/>
                <circle cx="20" cy="20" r="8" stroke="var(--color-royal)" stroke-width="2.5"/>
                <path d="M20 16V20L23 23" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="mb-card-title">Program matching</h3>
            <p>We know which lender has the best FHA pricing, which approves bank statement loans fastest, and which offers the most aggressive DSCR terms.</p>
          </article>
          <article class="mb-card fade-in">
            <div class="mb-card-icon">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="40" height="40" rx="8" fill="var(--color-royal-tint)"/>
                <rect x="12" y="14" width="16" height="12" rx="2" stroke="var(--color-royal)" stroke-width="2.5"/>
                <path d="M16 18H24M16 22H21" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="mb-card-title">One application, multiple options</h3>
            <p>You fill out one application. We do the rest — submitting to multiple lenders simultaneously and presenting you with the best options.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 4 — WHY STAIRWAY MORTGAGE
         ============================================================ -->
    <section class="section">
      <div class="container-page">
        <div class="mb-section-header fade-in">
          <p class="eyebrow eyebrow-blue">Why Stairway Mortgage</p>
          <h2 class="display-md">Why Stairway Mortgage Is Fort Lauderdale's Premier Mortgage Broker</h2>
        </div>

        <!-- Jim profile -->
        <div class="mb-leader fade-in">
          <div class="mb-leader-photo">
            <img
              src="/images/jim-blackburn-story.jpeg"
              alt="Jim Blackburn — Fort Lauderdale mortgage broker, Scotsman Guide Top Producer"
              width="280" height="350"
              loading="lazy"
              onerror="this.style.display='none'"
            />
          </div>
          <div class="mb-leader-text">
            <h3 class="mb-subtitle">Led by a Scotsman Guide Top Producer</h3>
            <p class="mb-leader-nmls mono">NMLS #1072866</p>
            <p>Jim Blackburn has closed over <strong>$500M+</strong> in loans across seven consecutive years as a Scotsman Guide Top Producer. Jim lives in Fort Lauderdale and serves clients nationwide — combining deep local market knowledge with nationwide lender access.</p>
            <a href="/branches/fort-lauderdale/jim-blackburn-team/" class="mb-link">Meet the team &rarr;</a>
          </div>
        </div>

        <!-- Specialty loan cards -->
        <h3 class="mb-subtitle mb-specialty-heading fade-in">Specialists in loans others can't close</h3>
        <div class="mb-grid-4 mb-loan-cards">
          <article class="mb-card mb-card-loan fade-in">
            <div class="mb-card-icon-sm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h10" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round"/></svg>
            </div>
            <h3 class="mb-card-title">Bank statement programs</h3>
            <p>12- or 24-month bank statements replace tax returns for self-employed borrowers.</p>
            <a href="/loan-programs/bank-statement-loan/" class="mb-link">Learn more &rarr;</a>
          </article>
          <article class="mb-card mb-card-loan fade-in">
            <div class="mb-card-icon-sm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 21L12 3L21 21H3Z" stroke="var(--color-royal)" stroke-width="2" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="mb-card-title">DSCR investor loans</h3>
            <p>Qualify based on property cash flow, not personal income. No W-2s, no tax returns.</p>
            <a href="/loan-programs/dscr-loan/" class="mb-link">Learn more &rarr;</a>
          </article>
          <article class="mb-card mb-card-loan fade-in">
            <div class="mb-card-icon-sm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7V17L12 22L22 17V7L12 2Z" stroke="var(--color-royal)" stroke-width="2" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="mb-card-title">Non-QM lending</h3>
            <p>Flexible documentation, recent credit events, interest-only — programs traditional lenders don't offer.</p>
            <a href="/loan-programs/non-qm-loan/" class="mb-link">Learn more &rarr;</a>
          </article>
          <article class="mb-card mb-card-loan fade-in">
            <div class="mb-card-icon-sm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 10L12 3L21 10V20C21 20.55 20.55 21 20 21H4C3.45 21 3 20.55 3 20V10Z" stroke="var(--color-royal)" stroke-width="2" stroke-linejoin="round"/><path d="M9 21V12H15V21" stroke="var(--color-royal)" stroke-width="2" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="mb-card-title">Jumbo &amp; super-jumbo</h3>
            <p>Programs for Fort Lauderdale's luxury waterfront market with alternative documentation options.</p>
            <a href="/loan-programs/jumbo-loan/" class="mb-link">Learn more &rarr;</a>
          </article>
        </div>

        <!-- Also a direct lender callout -->
        <div class="mb-also-direct fade-in">
          <div class="mb-direct-badge">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="14" r="12" stroke="var(--color-royal)" stroke-width="2"/><path d="M9 14L13 18L19 10" stroke="var(--color-royal)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div>
            <h3 class="mb-subtitle">Also a direct lender</h3>
            <p>Unlike most brokers, Stairway Mortgage also operates as a direct mortgage lender. When speed or control matters, we underwrite and fund in-house. Best of both worlds.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 5 — WHAT DOES A BROKER DO (Process Timeline)
         ============================================================ -->
    <section class="section mb-section-tinted">
      <div class="container-page">
        <div class="mb-section-header fade-in" style="max-width:56ch;">
          <p class="eyebrow">The Process</p>
          <h2 class="display-md">What Does a Mortgage Broker Actually Do?</h2>
          <p class="lede" style="margin-top:1rem;">When you hire a mortgage broker in Fort Lauderdale, you're hiring a licensed professional who works on your behalf — not the bank's.</p>
        </div>

        <div class="mb-timeline">
          <div class="mb-timeline-line" aria-hidden="true"></div>

          <article class="mb-timeline-step fade-in">
            <div class="mb-timeline-marker"><span class="mono">01</span></div>
            <div class="mb-timeline-content">
              <h3 class="mb-step-title">Deep financial analysis</h3>
              <p>Your broker reviews your complete financial picture: income, assets, debts, credit profile, employment history, and property goals. This isn't a surface-level pre-qualification — it's a deep analysis of which lending programs you qualify for and which will produce the best terms.</p>
            </div>
          </article>

          <article class="mb-timeline-step fade-in">
            <div class="mb-timeline-marker"><span class="mono">02</span></div>
            <div class="mb-timeline-content">
              <h3 class="mb-step-title">Simultaneous lender submission</h3>
              <p>Your broker submits your scenario to multiple wholesale lenders simultaneously. While a bank loan officer can only check their own institution's guidelines, your broker is running your file against the underwriting criteria of 300+ lending partners — using pricing engines that show live wholesale rates.</p>
            </div>
          </article>

          <article class="mb-timeline-step fade-in">
            <div class="mb-timeline-marker"><span class="mono">03</span></div>
            <div class="mb-timeline-content">
              <h3 class="mb-step-title">Options presentation</h3>
              <p>Your Fort Lauderdale mortgage broker presents you with options — not a single take-it-or-leave-it offer. You see the tradeoffs: this lender offers a lower rate but higher closing costs; that lender includes a credit that covers your appraisal fees. You make an informed choice.</p>
            </div>
          </article>

          <article class="mb-timeline-step fade-in">
            <div class="mb-timeline-marker"><span class="mono">04</span></div>
            <div class="mb-timeline-content">
              <h3 class="mb-step-title">Closing management</h3>
              <p>Your broker manages the loan through closing: ordering the appraisal, coordinating with the title company, managing conditions with the lender's underwriter, and ensuring nothing falls through the cracks. You have a single point of contact — not a call center.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 6 — HOW MUCH DOES A BROKER COST
         ============================================================ -->
    <section class="section">
      <div class="container-prose">
        <div class="mb-section-header fade-in">
          <p class="eyebrow eyebrow-blue">Transparency</p>
          <h2 class="display-md">How Much Does a Mortgage Broker in Fort Lauderdale Cost?</h2>
        </div>
        <div class="prose-editorial fade-in">
          <p>One of the most common questions borrowers ask is whether using a mortgage broker costs more than going directly to a bank. The answer, in most cases, is that it costs the same or less.</p>
          <p>Mortgage brokers are compensated through the wholesale lender's rate sheet. When a wholesale lender offers a rate to a broker, the compensation is built into that rate — just like a bank builds its profit margin into the rate it offers retail customers. The difference is that wholesale rates start lower, so even after broker compensation, the borrower's net cost is often better than a retail bank's offer.</p>
          <p>At Stairway Mortgage, most Fort Lauderdale mortgage broker fees are paid by the lender, not the borrower. Every fee is disclosed in your Loan Estimate within three business days of application — no surprises.</p>
        </div>

        <div class="mb-grid-2 mb-cost-cards">
          <article class="mb-card mb-card-cost fade-in">
            <div class="mb-card-icon-sm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="mb-card-title">Wholesale rates start lower</h3>
            <p>Broker channels access wholesale pricing designed for the mortgage industry — not the retail rates banks offer walk-in customers.</p>
          </article>
          <article class="mb-card mb-card-cost fade-in">
            <div class="mb-card-icon-sm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><rect x="3" y="5" width="18" height="14" rx="2" stroke="var(--color-royal)" stroke-width="2"/></svg>
            </div>
            <h3 class="mb-card-title">Lender-paid compensation</h3>
            <p>Most broker fees are paid by the wholesale lender, not you. When borrower-paid produces better economics, we show both options side by side.</p>
          </article>
          <article class="mb-card mb-card-cost fade-in">
            <div class="mb-card-icon-sm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 2v6h6M8 13h8M8 17h8" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="mb-card-title">Full fee disclosure</h3>
            <p>Every fee disclosed in your Loan Estimate within 3 business days. No hidden costs, no surprises at the closing table.</p>
          </article>
          <article class="mb-card mb-card-cost fade-in">
            <div class="mb-card-icon-sm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="var(--color-royal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="mb-card-title">Dodd-Frank protection</h3>
            <p>Federal law prohibits mortgage brokers from receiving compensation from both the lender and borrower on the same transaction.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 7 — COMPARISON TABLE
         ============================================================ -->
    <section class="section mb-section-tinted">
      <div class="container-page">
        <div class="mb-section-header fade-in">
          <p class="eyebrow eyebrow-rust">Side by Side</p>
          <h2 class="display-md">What Makes Stairway Mortgage Different</h2>
        </div>
        <div class="mb-table-wrap fade-in">
          <table class="mb-compare">
            <thead>
              <tr>
                <th>Feature</th>
                <th class="mb-col-stairway">Mortgage Broker (Stairway)</th>
                <th>Traditional Bank</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Lender options</td>
                <td class="mb-yes"><span class="mb-check" aria-hidden="true">&#10003;</span> 300+ wholesale lenders</td>
                <td class="mb-no"><span class="mb-cross" aria-hidden="true">&#10005;</span> 1 (their own)</td>
              </tr>
              <tr>
                <td>Rate shopping</td>
                <td class="mb-yes"><span class="mb-check" aria-hidden="true">&#10003;</span> Done for you</td>
                <td class="mb-no"><span class="mb-cross" aria-hidden="true">&#10005;</span> You do it yourself</td>
              </tr>
              <tr>
                <td>Non-QM / specialty</td>
                <td class="mb-yes"><span class="mb-check" aria-hidden="true">&#10003;</span> Wide selection</td>
                <td class="mb-no"><span class="mb-cross" aria-hidden="true">&#10005;</span> Limited or none</td>
              </tr>
              <tr>
                <td>Wholesale pricing</td>
                <td class="mb-yes"><span class="mb-check" aria-hidden="true">&#10003;</span> Yes</td>
                <td class="mb-no"><span class="mb-cross" aria-hidden="true">&#10005;</span> No (retail rates)</td>
