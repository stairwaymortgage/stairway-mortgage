---
import Layout from '../layouts/Layout.astro';
const breadcrumbSchema={"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.stairwaymortgage.com/"}, {"@type": "ListItem", "position": 2, "name": "Do Not Sell or Share"}]};
---

<Layout title="Do Not Sell or Share My Personal Information | Stairway" description="Opt out of advertising sharing and targeted advertising by Stairway Mortgage, in this browser or everywhere." canonical="https://www.stairwaymortgage.com/do-not-sell-or-share/">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <nav class="container-page ft-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> <span>/</span> <span>Do Not Sell or Share</span>
  </nav>
  <header class="container-prose ft-header">
    <span class="eyebrow eyebrow-blue mb-4">Legal</span>
    <h1 class="display-md">Do Not Sell or Share My Personal Information</h1>
  </header>
  <article class="container-prose prose-editorial ft-body">
    <p>We do not sell personal information for money. We do use advertising tools, such as the Meta Pixel and Google Ads, and may upload hashed customer lists to our own advertising accounts to show you our ads. California, Oregon and some other states treat this as &ldquo;sharing&rdquo; or &ldquo;targeted advertising,&rdquo; and you can opt out.</p>

    <p><strong>Opt out in this browser:</strong></p>
    <div class="ft-optout">
      <button type="button" id="sw-optout-btn" class="btn btn-primary">Opt out now</button>
      <p id="sw-optout-status" class="ft-optout-status" role="status" aria-live="polite"></p>
    </div>

    <p><strong>Opt out everywhere (including customer-list uploads):</strong> email <a href="mailto:privacy@stairwaymortgage.com?subject=Opt%20out">privacy@stairwaymortgage.com</a> with &ldquo;Opt out&rdquo; in the subject, and include the name, email and phone number you used with us. We&rsquo;ll remove you from our advertising audiences within 15 business days.</p>

    <p>Your browser&rsquo;s Global Privacy Control signal is also honored automatically as an opt-out for that browser.</p>

    <p>See our <a href="/privacy/">Privacy Policy</a>, <a href="/california-privacy/">California Privacy Notice</a> and <a href="/oregon-privacy/">Oregon Privacy Notice</a>.</p>
  </article>
</Layout>

<script is:inline>
  (function() {
    var btn = document.getElementById('sw-optout-btn');
    var status = document.getElementById('sw-optout-status');
    if (!btn || !status) return;
    var DONE = "You’re opted out in this browser.";
    function optedOut() {
      try { return /(?:^|;\s*)sw_ad_optout=1(?:;|$)/.test(document.cookie); } catch (e) { return false; }
    }
    function markDone() { status.textContent = DONE; btn.disabled = true; }
    if (optedOut()) {
      markDone();
    } else if (navigator.globalPrivacyControl === true) {
      status.textContent = "Your browser is sending a Global Privacy Control signal, so you’re already opted out in this browser.";
    }
    btn.addEventListener('click', function() {
      try {
        document.cookie = 'sw_ad_optout=1; max-age=31536000; path=/; SameSite=Lax';
      } catch (e) {}
      if (optedOut()) {
        markDone();
      } else {
        status.textContent = "We couldn’t save your choice in this browser (cookies may be blocked). Please email privacy@stairwaymortgage.com to opt out.";
      }
    });
  })();
</script>

<style>
  .ft-breadcrumb { font-family:var(--stw-mono, 'JetBrains Mono'), monospace; font-size:12px; color:var(--color-mute); padding-top:2rem; padding-bottom:1.25rem; }
  .ft-breadcrumb a { color:var(--color-mute); text-decoration:none; } .ft-breadcrumb a:hover { color:var(--color-blue); }
  .ft-breadcrumb span { margin-inline:0.4rem; opacity:0.5; }
  .ft-header { padding-top:0.5rem; padding-bottom:1rem; }
  .ft-body { margin-top:1.5rem; padding-bottom:4rem; }
  .ft-body :global(p) { font-size:16px; line-height:1.7; margin-bottom:1.1rem; color:var(--color-ink-light); }
  .ft-body :global(a) { color:var(--color-blue); text-decoration:underline; text-underline-offset:2px; }
  .ft-optout { display:flex; flex-wrap:wrap; align-items:center; gap:0.75rem 1rem; margin:0 0 1.6rem; }
  .ft-optout button[disabled] { opacity:0.6; cursor:default; }
  .ft-body .ft-optout-status { margin:0; font-weight:600; color:var(--color-ink); }
  .ft-body .ft-optout-status:empty { display:none; }
</style>
