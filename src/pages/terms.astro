---
import Layout from '../layouts/Layout.astro';
const breadcrumbSchema={"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.stairwaymortgage.com/"}, {"@type": "ListItem", "position": 2, "name": "Terms"}]};
