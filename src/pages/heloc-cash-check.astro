---
/**
 * /heloc-cash-check/ — headless HELOC ad landing page (Facebook/IG/TikTok/YouTube Shorts).
 * No site header/nav on purpose. seemyheloc.com 301s here (Cloudflare page rule, utm_source=seemyheloc).
 * Leads post to the shared GHL webhook with form_source "heloc_cash_check".
 * Fields: first_name, last_name, full_name, email, phone, sms_consent, home_value,
 * mortgage_balance, heloc_available_estimate + standard attribution (utm_*, umtid, loid, landing_page).
 */
import Analytics from '../components/Analytics.astro';
import LoAttribution from '../components/LoAttribution.astro';
import leadAttributionSrc from '../lib/lead-attribution.js?raw';
import { GHL_WEBHOOK_URL } from '../lib/ghl';
const canonical = 'https://www.stairwaymortgage.com/heloc-cash-check/';
const title = 'HELOC Cash Check | Stairway Mortgage';
const description = 'See how much cash your home equity could open up with a HELOC. Two numbers, instant estimate, no credit pull. Jim Blackburn, NMLS #1072866.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/favicon-180.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex,follow" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="How much cash is sitting in your home?" />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://www.stairwaymortgage.com/social-card.png" />
  <meta property="og:site_name" content="Stairway Mortgage" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" />
  <Analytics />
  <LoAttribution />
  <script is:inline set:html={leadAttributionSrc}></script>
  <style is:global>
html,body{margin:0}
img,video{max-width:100%}

/* Layout: headless single-column ad landing — logo strip, calculator hero, reasons, how-it-works, FAQ, real reviews, compliance footer. No nav. */
:root{
  --ink:#0A0E1A; --paper:#FAFAF7; --card:#FFFFFF; --line:#DCDDD6; --muted:#3F4556;
  --blue:#1845D6; --blue-ink:#FFFFFF; --rust:#8B2C2C; --green:#2E9E2E; --green-bg:#E9F6E9;
  --hero:#0A0E1A; --hero-fg:#FAFAF7; --hero-muted:#C9CDD9; --sky:#EEF3FF; --soft:#5A6072;
  color-scheme:light;
  --display:"Fraunces",Georgia,"Times New Roman",serif;
  --body:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
body{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:18px;line-height:1.6;-webkit-font-smoothing:antialiased}
.wrap{max-width:1040px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
h1,h2,h3{font-family:var(--display);text-wrap:balance;line-height:1.12;margin:0}
h2{font-size:clamp(28px,5vw,40px);font-weight:700}
h3{font-size:22px;font-weight:700}
p{margin:0}
.eyebrow{font-family:var(--mono);font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:700}
.num{font-variant-numeric:tabular-nums}

/* Hero */
.hero{background:linear-gradient(180deg,var(--sky) 0%,var(--paper) 100%);color:var(--ink)}
.hero .wrap{padding-block:14px 40px;display:grid;gap:18px}
.brand{display:flex;justify-content:space-between;align-items:center;gap:10px}
.brand img{height:30px;width:auto}
.brand .nmls{font-family:var(--mono);font-size:11px;color:var(--soft);text-align:right}
.hero-grid{display:grid;gap:28px;grid-template-columns:1fr}
@media(min-width:900px){.hero-grid{grid-template-columns:1fr 1.05fr;align-items:center}}
.hero h1{font-size:clamp(30px,7.2vw,46px);font-weight:700;letter-spacing:-.01em}
.hero h1 em{font-style:normal;color:var(--blue)}
.lede{font-size:18px;color:var(--soft);margin-top:8px;max-width:34ch}
.pick{margin-top:18px;display:grid;gap:10px;max-width:30rem}
.pick-q{font-family:var(--display);font-weight:700;font-size:22px;line-height:1.25;margin:0}
.pick-hint{font-size:15px;color:var(--soft);margin:-4px 0 2px}
.opt{display:flex;justify-content:space-between;align-items:center;gap:12px;width:100%;text-align:left;background:var(--card);color:var(--ink);border:2px solid var(--line);border-radius:14px;padding:15px 16px;font:600 17px var(--body);cursor:pointer;transition:border-color .15s,transform .15s,background .15s}
.opt::after{content:"→";font-family:var(--mono);color:var(--blue);font-weight:700}
.opt:hover,.opt:focus-visible{border-color:var(--blue);outline:none;transform:translateX(3px)}
.opt.on{border-color:var(--blue);background:var(--sky)}
.opt.on::after{content:"✓"}
.picked{background:var(--sky);color:var(--blue);border-radius:10px;padding:8px 12px;font-weight:600;font-size:15px;margin:-4px 0 14px}
.formula{margin-top:18px;font-family:var(--mono);font-size:13px;color:var(--soft);border-left:3px solid var(--blue);padding-left:12px}

/* Calculator */
.calc{background:var(--card);color:var(--ink);border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 14px 40px rgba(24,69,214,.10);min-width:0;scroll-margin-top:16px}
.calc-top{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:14px}
.calc-top .eyebrow{color:var(--blue)}
.dots{display:flex;gap:6px}
.dots i{width:22px;height:5px;border-radius:3px;background:var(--line)}
.dots i.on{background:var(--blue)}
.step label.q{display:block;font-family:var(--display);font-size:clamp(24px,4.6vw,30px);font-weight:700;line-height:1.2;margin-bottom:6px}
.step .hint{color:var(--muted);font-size:16px;margin-bottom:14px}
.field{display:flex;align-items:center;border:2px solid var(--line);border-radius:12px;background:var(--paper);transition:border-color .15s}
.field:focus-within{border-color:var(--blue)}
.field span{font-family:var(--mono);font-size:24px;font-weight:700;padding-left:16px;color:var(--muted)}
.field input{flex:1;min-width:0;border:0;background:transparent;color:var(--ink);font-family:var(--body);font-size:24px;font-weight:600;padding:16px 14px;outline:none}
.two{display:grid;gap:12px;grid-template-columns:1fr 1fr}
@media(max-width:460px){.two{grid-template-columns:1fr}}
.two .field input{font-size:20px}
.taps{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.tap{border:2px solid var(--line);background:transparent;color:var(--ink);border-radius:999px;padding:8px 14px;font:600 15px var(--body);cursor:pointer}
.tap:hover,.tap:focus-visible{border-color:var(--blue);outline:none}
.err{color:var(--rust);font-weight:600;font-size:15px;margin-top:10px;min-height:1.4em}
.nav{display:flex;gap:10px;margin-top:8px}
.btn{flex:1;border:0;border-radius:12px;background:var(--blue);color:var(--blue-ink);font:700 20px var(--body);padding:18px;cursor:pointer}
.btn:focus-visible,.back:focus-visible{outline:3px solid var(--green);outline-offset:2px}
.back{border:2px solid var(--line);border-radius:12px;background:transparent;color:var(--ink);font:600 17px var(--body);padding:0 18px;cursor:pointer}
.consent{display:flex;gap:10px;align-items:flex-start;font-size:13px;line-height:1.45;color:var(--muted);margin-top:14px}
.consent input{width:22px;height:22px;flex:none;margin-top:1px;accent-color:var(--blue)}
.fine{font-size:13px;color:var(--muted);margin-top:12px;line-height:1.45}

/* Result */
.result{text-align:left}
.result .eyebrow{color:var(--green)}
.big{font-family:var(--display);font-weight:800;font-size:clamp(48px,11vw,72px);line-height:1;color:var(--green);margin:10px 0 6px}
.math{margin-top:16px;border:1px solid var(--line);border-radius:12px;overflow:hidden}
.math div{display:flex;justify-content:space-between;gap:12px;padding:12px 14px;font-size:17px}
.math div+div{border-top:1px solid var(--line)}
.math b{font-family:var(--mono)}
.math .total{background:var(--green-bg);font-weight:700}
.next{margin-top:16px;font-size:18px;font-weight:600}
.callrow{margin-top:10px;font-size:16px;color:var(--muted)}
.callrow strong{color:var(--ink);font-family:var(--mono);user-select:all}

/* Sections */
section.band .wrap{padding-block:56px}
section.band+section.band{border-top:1px solid var(--line)}
.sec-head{display:grid;gap:10px;margin-bottom:28px;max-width:44rem}
.sec-head .eyebrow{color:var(--blue)}
.sec-head p{color:var(--muted)}
.reasons{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.reason{border-top:3px solid var(--ink);padding-top:14px;display:grid;gap:6px;align-content:start}
.reason p{color:var(--muted);font-size:17px}
.stack{display:grid;gap:12px;grid-template-columns:1fr;max-width:46rem}
.lien{display:grid;grid-template-columns:44px 1fr;gap:14px;align-items:start;padding:16px;border:1px solid var(--line);border-radius:12px;background:var(--card)}
.lien .tag{font-family:var(--mono);font-weight:700;font-size:15px;width:44px;height:44px;border-radius:10px;display:grid;place-items:center;background:var(--paper);border:1px solid var(--line)}
.lien.second .tag{background:var(--blue);color:var(--blue-ink);border-color:var(--blue)}
.lien p{color:var(--muted);font-size:17px}
.faq{max-width:46rem;display:grid;gap:0}
.faq details{border-bottom:1px solid var(--line);padding:4px 0}
.faq summary{cursor:pointer;font-weight:700;font-size:19px;padding:14px 0;list-style:none;display:flex;justify-content:space-between;gap:12px}
.faq summary::after{content:"+";font-family:var(--mono);color:var(--blue)}
.faq details[open] summary::after{content:"–"}
.faq details p{color:var(--muted);padding-bottom:16px}
.reviews{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
.rev{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px;display:grid;gap:12px;align-content:space-between}
.rev blockquote{margin:0;font-size:17px;line-height:1.55}
.rev .who{font-weight:700;font-size:15px}
.rev .who span{display:block;font-weight:500;color:var(--muted)}
.fast{background:var(--card)}
.perks{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.perk{border:2px solid var(--line);border-radius:14px;padding:18px;display:grid;gap:6px;align-content:start;background:var(--paper)}
.perk .k{font-family:var(--display);font-weight:800;font-size:34px;line-height:1;color:var(--green)}
.perk p{color:var(--muted);font-size:16px}
.flow{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));margin-top:28px;counter-reset:f}
.flow li{list-style:none;display:grid;grid-template-columns:44px 1fr;gap:12px;align-items:start}
.flow li::before{counter-increment:f;content:counter(f);font-family:var(--mono);font-weight:700;font-size:18px;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:var(--blue);color:var(--blue-ink)}
.flow b{display:block;font-size:19px}
.flow span{color:var(--muted);font-size:16px}
.flow{padding:0;margin-bottom:0}
.foot-note{font-size:13px;color:var(--muted);margin-top:18px;max-width:52rem;line-height:1.5}
.lo{display:flex;gap:14px;align-items:center;margin-top:24px}
.lo img{width:96px;height:96px;border-radius:18px;object-fit:cover;object-position:50% 20%;background:#FFFFFF;flex:none}
.lo b{display:block;font-size:18px;color:var(--ink)}
.lo span{font-size:15px;color:var(--soft)}
.trio{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;width:100%}
.trio figure{margin:0;display:grid;gap:4px;text-align:center}
.trio figcaption{font-weight:700;font-size:15px}
.lo-r{flex-direction:column;align-items:stretch;flex-wrap:wrap;display:flex;gap:12px;align-items:center;margin-top:16px;padding:12px;border:1px solid var(--line);border-radius:12px}
.lo-r .trio img{width:100%;aspect-ratio:1/1;height:auto;border-radius:14px;background:#FFFFFF;object-fit:cover;object-position:50% 25%;flex:none}
.lo-r p{font-size:16px;font-weight:600}
.meet{display:grid;gap:28px;grid-template-columns:1fr;align-items:center}
@media(min-width:820px){.meet{grid-template-columns:.9fr 1.1fr}}
.meet img{width:100%;max-width:100%;border-radius:18px;display:block;object-fit:cover;object-position:50% 25%;aspect-ratio:6/5;background:#0A0E1A}
.meet .copy{display:grid;gap:14px;min-width:0}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:6px}
.stats div{border-top:3px solid var(--blue);padding-top:8px}
.stats b{display:block;font-family:var(--display);font-size:28px;font-weight:800;line-height:1.1}
.stats span{font-size:14px;color:var(--muted);line-height:1.35;display:block}
@media(max-width:420px){.stats b{font-size:23px}}
.family{display:grid;gap:14px}
section.band .wrap.family{padding-block:0 56px}
.fam-grid{display:grid;gap:10px;grid-template-columns:1.15fr 1fr;align-items:stretch}
.fam-grid .ph{margin:0;border-radius:14px;overflow:hidden;background:var(--paper);display:grid;place-items:center;color:var(--muted);font-size:15px;font-weight:600;text-align:center;padding:12px;min-height:0}
.fam-grid .ph img{width:100%;height:100%;object-fit:cover;object-position:50% 30%;display:block}
.fam-grid .ph{padding:0}
.fam-grid .a{aspect-ratio:4/5}
.fam-grid .a img{object-position:50% 40%}
.fam-grid .b{aspect-ratio:4/5}
.fam-grid .b img{object-position:50% 20%}
@media(max-width:520px){.fam-grid{grid-template-columns:1fr}.fam-grid .a{aspect-ratio:5/6}.fam-grid .b{aspect-ratio:1/1}}
.drew{display:grid;grid-template-columns:84px 1fr;gap:14px;align-items:start;padding:16px;border:1px solid var(--line);border-radius:14px;background:var(--card)}
.drew img{width:84px;height:84px;border-radius:50%;object-fit:cover;object-position:50% 25%}
.drew b{font-size:19px;display:block}
.drew .role{display:block;font-size:14px;color:var(--muted);margin-bottom:6px}
.drew p{font-size:16px;color:var(--muted)}
.duo{display:flex;flex:none}
.duo img+img{margin-left:-14px;border:2px solid var(--card)}
.fam-note{font-family:var(--display);font-style:italic;font-weight:400;font-size:clamp(20px,3.6vw,24px);line-height:1.45;max-width:40rem}
.fam-note span{display:block;font-family:var(--body);font-style:normal;font-size:15px;color:var(--muted);margin-top:6px}
.team{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
.mate{margin:0;display:grid;gap:10px;align-content:start}
.mate img{width:100%;max-width:100%;aspect-ratio:1/1;object-fit:cover;object-position:50% 20%;border-radius:20px;background:#FFFFFF;display:block;box-shadow:0 10px 30px rgba(10,14,26,.12)}
.mate b{font-family:var(--display);font-size:24px;font-weight:700;line-height:1.2}
.mate .role{font-family:var(--mono);font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--blue);font-weight:700}
.mate p{color:var(--muted);font-size:17px}
.mate .say{font-family:var(--display);font-style:italic;font-size:19px;color:var(--ink)}
.vid{display:grid;gap:8px;justify-items:center}
.vid video{width:100%;max-width:340px;aspect-ratio:9/16;border-radius:20px;background:#0A0E1A;display:block;box-shadow:0 18px 40px rgba(10,14,26,.25);object-fit:cover}
.vid-wide video{max-width:100%;aspect-ratio:16/9;width:100%}
.vid-cap{font-size:14px;color:var(--muted);font-weight:600}
.laugh{display:grid;gap:24px;margin-top:40px;align-items:center;grid-template-columns:1fr}
@media(min-width:820px){.laugh{grid-template-columns:auto 1fr}}
.laugh-copy{display:grid;gap:10px;min-width:0;max-width:30rem}
.cta2 .wrap{padding-block:48px;display:grid;gap:16px;justify-items:start}
.cta2 .btn{flex:none;padding:18px 28px}
footer{background:var(--hero);color:var(--hero-muted);font-size:14px;line-height:1.55}
footer .wrap{padding-block:32px;display:grid;gap:10px}
footer strong{color:var(--hero-fg)}
footer a{color:var(--hero-fg)}
@media(prefers-reduced-motion:no-preference){.step,.result{animation:in .25s ease-out}@keyframes in{from{opacity:.4;transform:translateY(6px)}to{opacity:1;transform:none}}}

  </style>
</head>
<body>
<header class="hero">
  <div class="wrap">
    <div class="brand">
      <img src="/heloc-cash-check/logo.png" alt="Stairway Mortgage">
      <span class="nmls">Jim Blackburn<br>NMLS #1072866</span>
    </div>
    <div class="hero-grid">
      <div>
                <h1>How much cash is in <em>your home?</em></h1>
        <p class="lede">Tap what matters most. No credit pull.</p>
        <div class="pick" role="group" aria-label="Which of these matters most to you?">
          <button type="button" class="opt" data-pick="Closing in about a week">Closing in about a week*</button>
          <button type="button" class="opt" data-pick="No appraisal">No appraisal for most homes*</button>
          <button type="button" class="opt" data-pick="No tax returns or pay stubs">No tax returns or pay stubs</button>
          <button type="button" class="opt" data-pick="Soft credit check only">Soft credit check only</button>
        </div>
        <div class="lo"><img src="/heloc-cash-check/jim.webp" alt="Jim Blackburn, loan officer" onerror="this.hidden=true"><div><b>Jim Blackburn &amp; team</b><span>Your loan officer · NMLS #1072866<br>Drew and Alisha will help you get started.</span></div></div>
      </div>

      <form class="calc" id="helocForm" novalidate autocomplete="on">
        <p class="picked" id="picked" hidden></p>
        <div class="calc-top"><span class="eyebrow" id="stepLabel">Step 1 of 4</span><div class="dots" id="dots"><i class="on"></i><i></i><i></i><i></i></div></div>

        <div class="step" data-step="1">
          <label class="q" for="homeValue">What is your home worth today?</label>
          <p class="hint">Your best guess is fine. A recent online estimate works.</p>
          <div class="field"><span>$</span><input id="homeValue" name="home_value" inputmode="numeric" placeholder="650,000" autocomplete="off"></div>
          <div class="taps"><button type="button" class="tap" data-fill="homeValue" data-v="400000">$400k</button><button type="button" class="tap" data-fill="homeValue" data-v="650000">$650k</button><button type="button" class="tap" data-fill="homeValue" data-v="900000">$900k</button><button type="button" class="tap" data-fill="homeValue" data-v="1500000">$1.5M</button></div>
        </div>

        <div class="step" data-step="2" hidden>
          <label class="q" for="balance">What do you still owe on your first mortgage?</label>
          <p class="hint">The payoff balance, not the original loan amount.</p>
          <div class="field"><span>$</span><input id="balance" name="mortgage_balance" inputmode="numeric" placeholder="310,000" autocomplete="off"></div>
          <div class="taps"><button type="button" class="tap" data-fill="balance" data-v="0">I own it free and clear</button></div>
        </div>

        <div class="step" data-step="3" hidden>
          <label class="q" for="firstName">Where should we send your number?</label>
          <p class="hint">Your estimate appears on the next screen.</p>
          <div class="two">
            <div class="field"><input id="firstName" name="first_name" placeholder="First name" autocomplete="given-name"></div>
            <div class="field"><input id="lastName" name="last_name" placeholder="Last name" autocomplete="family-name"></div>
          </div>
          <div class="field" style="margin-top:12px"><input id="email" name="email" type="email" inputmode="email" placeholder="Email" autocomplete="email"></div>
        </div>

        <div class="step" data-step="4" hidden>
          <label class="q" for="phone">Best mobile number?</label>
          <p class="hint">Drew, Alisha or Jim will call or text you as soon as possible.</p>
          <div class="field"><input id="phone" name="phone" type="tel" inputmode="tel" placeholder="(954) 555-0123" autocomplete="tel"></div>
          <label class="consent" for="smsConsent"><input type="checkbox" id="smsConsent" name="sms_consent"><span>I agree to receive calls and text messages from Stairway Mortgage about my inquiry at the number above, including by automated means. Consent is not a condition of any purchase or loan. Message and data rates may apply. Reply STOP to opt out, HELP for help.</span></label>
        </div>

        <div class="result" id="result" hidden>
          <p class="eyebrow">Your estimated HELOC line</p>
          <p class="big num" id="bigNum">$0</p>
          <p id="resultMsg" style="font-size:18px">Here is how we got there.</p>
          <div class="math num">
            <div><span>Home value</span><b id="rValue"></b></div>
            <div><span>Up to 90% of value</span><b id="rNinety"></b></div>
            <div><span>Minus first mortgage</span><b id="rBal"></b></div>
            <div class="total"><span>Estimated available</span><b id="rAvail"></b></div>
          </div>
