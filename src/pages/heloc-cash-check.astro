<script is:inline define:vars={{ WEBHOOK: GHL_WEBHOOK_URL }}>
(function(){
  var form=document.getElementById('helocForm'), steps=[].slice.call(form.querySelectorAll('.step'));
  var cur=1, total=4, err=document.getElementById('err');
  var $=function(id){return document.getElementById(id)};
  var digits=function(s){return Number(String(s||'').replace(/[^0-9.]/g,''))||0};
  var money=function(n){return '$'+Math.round(n).toLocaleString('en-US')};
  ['homeValue','balance'].forEach(function(id){
    $(id).addEventListener('input',function(e){var n=String(e.target.value).replace(/[^0-9]/g,'');e.target.value=n?Number(n).toLocaleString('en-US'):''});
  });
  form.querySelectorAll('.tap').forEach(function(b){b.addEventListener('click',function(){
    $(b.dataset.fill).value=Number(b.dataset.v).toLocaleString('en-US'); go(1);
  })});
  function show(n){
    cur=n; steps.forEach(function(s){s.hidden=Number(s.dataset.step)!==n});
    $('stepLabel').textContent='Step '+n+' of '+total;
    [].forEach.call($('dots').children,function(d,i){d.className=i<n?'on':''});
    $('backBtn').hidden=n===1; $('nextBtn').textContent=n===total?'See My Options':'Next'; err.textContent='';
    var f=steps[n-1].querySelector('input:not([type=checkbox])'); if(f) try{f.focus({preventScroll:true})}catch(e){}
  }
  function check(n){
    if(n===1){var v=digits($('homeValue').value); if(v<50000) return 'Enter your home value, for example 650,000.'}
    if(n===2){var b=$('balance').value.trim(); if(b==='') return 'Enter what you owe, or tap "I own it free and clear".';
      if(digits(b)>digits($('homeValue').value)*1.5) return 'That balance looks higher than the home value. Double-check both numbers.'}
    if(n===3){if(!$('firstName').value.trim()||!$('lastName').value.trim()) return 'Add your first and last name.';
      if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test($('email').value.trim())) return 'Enter a valid email address.'}
    if(n===4){if(String($('phone').value).replace(/\D/g,'').length<10) return 'Enter a 10-digit mobile number.';
      if(!$('smsConsent').checked) return 'Check the box so our team can text and call you about your estimate.'}
    return '';
  }
  function go(dir){
    if(dir>0){var m=check(cur); if(m){err.textContent=m;return}}
    if(dir>0&&cur===total){finish();return}
    show(Math.min(total,Math.max(1,cur+dir)));
  }
  // Enter key advances one step instead of submitting the whole form
  form.addEventListener('keydown',function(e){if(e.key==='Enter'&&e.target.tagName==='INPUT'&&e.target.type!=='checkbox'){e.preventDefault();go(1)}});
  form.addEventListener('submit',function(e){e.preventDefault();go(1)});
  $('backBtn').addEventListener('click',function(){go(-1)});
  $('toTop').addEventListener('click',function(){form.scrollIntoView({behavior:'smooth',block:'start'});show(cur)});

  var qs=new URLSearchParams(location.search);
  var priority='';
  [].forEach.call(document.querySelectorAll('.opt'),function(b){b.addEventListener('click',function(){
    priority=b.getAttribute('data-pick');
    [].forEach.call(document.querySelectorAll('.opt'),function(o){o.classList.toggle('on',o===b)});
    var pk=$('picked'); pk.textContent='✓ Got it: '+priority.toLowerCase()+'. Now let\u2019s find your number.'; pk.hidden=false;
    var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    form.scrollIntoView({behavior:reduce?'auto':'smooth',block:'start'});
    setTimeout(function(){try{$('homeValue').focus({preventScroll:true})}catch(e){}},reduce?0:450);
  })});

  function finish(){
    var V=digits($('homeValue').value), B=digits($('balance').value), ninety=V*0.9, avail=Math.max(0,ninety-B);
    $('rValue').textContent=money(V); $('rNinety').textContent=money(ninety); $('rBal').textContent='− '+money(B); $('rAvail').textContent=money(avail);
    $('bigNum').textContent=money(avail);
    $('resultMsg').textContent = avail>0 ? 'Here is how we got there.' : 'Based on these numbers there is little room under the 90% mark today. A loan officer can still review other options with you.';
    steps.forEach(function(s){s.hidden=true}); $('result').hidden=false; $('nav').hidden=true; $('formFine').hidden=true;
    $('stepLabel').textContent='Your estimate'; [].forEach.call($('dots').children,function(d){d.className='on'});
    var la=(window.STW_leadAttribution&&window.STW_leadAttribution())||{};
    var payload={form_source:'heloc_cash_check',loan_purpose:'HELOC',top_priority:priority,
      first_name:$('firstName').value.trim(),last_name:$('lastName').value.trim(),
      full_name:($('firstName').value.trim()+' '+$('lastName').value.trim()).trim(),
      email:$('email').value.trim(),phone:$('phone').value.trim(),sms_consent:'yes',
      home_value:V,mortgage_balance:B,heloc_available_estimate:Math.round(avail),
      page_url:location.origin+location.pathname,
      source_url:(window.STW_sourceUrl?window.STW_sourceUrl():(document.referrer||location.href)),
      landing_page:la.landing_page||'',utm_source:la.utm_source||qs.get('utm_source')||'',utm_medium:la.utm_medium||'',
      utm_campaign:la.utm_campaign||'',utm_term:la.utm_term||'',utm_content:la.utm_content||'',
      umtid:la.umtid||'',loid:la.loid||'',fbclid:qs.get('fbclid')||''};
    try{fetch(WEBHOOK,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload),keepalive:true})
      .then(function(r){if(r&&r.ok){if(window.STW_fireGenerateLead)window.STW_fireGenerateLead({profession:'',county:'',umtid:payload.umtid});}else{console.warn('[lead] heloc_cash_check submit failed:',r&&r.status);}})
      .catch(function(e){console.warn('[lead] heloc_cash_check submit error:',e);});}catch(e){}
    try{if(window.fbq)fbq('track','Lead',{content_name:'HELOC Cash Check'})}catch(e){}
    form.scrollIntoView({behavior:'smooth',block:'start'});
  }
  show(1);
})();
</script>
